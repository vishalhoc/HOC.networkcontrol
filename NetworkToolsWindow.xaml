<Window
    x:Class="WinNetControl.NetworkToolsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Network Tools">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Padding="16,10" BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE774;" FontSize="18"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="Network Tools" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Tab content -->
        <TabView Grid.Row="1" x:Name="MainTabs" TabWidthMode="Equal"
                 IsAddTabButtonVisible="False">

            <!-- ═══ PING ═══════════════════════════════════════════════════ -->
            <TabViewItem Header="&#xE879;  Ping">
                <Grid RowSpacing="10" Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PingHostBox" Header="Host / IP Address"
                                 PlaceholderText="e.g. google.com or 8.8.8.8"
                                 KeyboardAcceleratorPlacementMode="Hidden"/>
                        <NumberBox x:Name="PingCountBox" Grid.Column="1" Header="Count"
                                   Value="4" Minimum="1" Maximum="100" SpinButtonPlacementMode="Inline"/>
                        <Button Grid.Column="2" x:Name="PingBtn" Content="Ping"
                                VerticalAlignment="Bottom" Padding="20,8"
                                Click="OnPingClicked" Style="{StaticResource AccentButtonStyle}"/>
                        <Button Grid.Column="3" x:Name="StopPingBtn" Content="Stop"
                                VerticalAlignment="Bottom" Padding="20,8" IsEnabled="False"
                                Click="OnStopPingClicked"/>
                    </Grid>

                    <Border Grid.Row="1" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <ScrollViewer x:Name="PingScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="PingResults" Padding="12,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas"
                                                   FontSize="12" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Row="2" CornerRadius="6" Padding="10,6"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <TextBlock x:Name="PingStats" FontSize="11" FontFamily="Consolas"
                                   Foreground="Gray" Text="Ready — enter a host and click Ping"/>
                    </Border>
                </Grid>
            </TabViewItem>

            <!-- ═══ TRACEROUTE ══════════════════════════════════════════════ -->
            <TabViewItem Header="&#xE7BA;  Traceroute">
                <Grid RowSpacing="10" Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TraceHostBox" Header="Host / IP Address"
                                 PlaceholderText="e.g. google.com"/>
                        <Button Grid.Column="1" x:Name="TraceBtn" Content="Trace Route"
                                VerticalAlignment="Bottom" Padding="20,8"
                                Click="OnTraceClicked" Style="{StaticResource AccentButtonStyle}"/>
                        <Button Grid.Column="2" x:Name="StopTraceBtn" Content="Stop"
                                VerticalAlignment="Bottom" Padding="20,8" IsEnabled="False"
                                Click="OnStopTraceClicked"/>
                    </Grid>

                    <Border Grid.Row="1" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <ScrollViewer x:Name="TraceScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TraceResults" Padding="12,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas"
                                                   FontSize="12" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabViewItem>

            <!-- ═══ PORT SCANNER ════════════════════════════════════════════ -->
            <TabViewItem Header="&#xE9CE;  Port Scanner">
                <Grid RowSpacing="10" Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ScanHostBox" Header="Host / IP"
                                 PlaceholderText="e.g. 192.168.1.1"/>
                        <NumberBox x:Name="ScanFromBox" Grid.Column="1" Header="From Port"
                                   Value="1" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Inline"/>
                        <NumberBox x:Name="ScanToBox" Grid.Column="2" Header="To Port"
                                   Value="1024" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Inline"/>
                        <NumberBox x:Name="ScanTimeoutBox" Grid.Column="3" Header="Timeout (ms)"
                                   Value="200" Minimum="50" Maximum="5000" SpinButtonPlacementMode="Inline"/>
                        <Button Grid.Column="4" x:Name="ScanBtn" Content="Scan"
                                VerticalAlignment="Bottom" Padding="20,8"
                                Click="OnScanClicked" Style="{StaticResource AccentButtonStyle}"/>
                        <Button Grid.Column="5" x:Name="StopScanBtn" Content="Stop"
                                VerticalAlignment="Bottom" Padding="20,8" IsEnabled="False"
                                Click="OnStopScanClicked"/>
                    </Grid>

                    <!-- Results header -->
                    <Border Grid.Row="1" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Padding="12,6" CornerRadius="8,8,0,0"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Port" FontSize="10" FontWeight="SemiBold" Foreground="Gray"/>
                                    <TextBlock Grid.Column="1" Text="Status" FontSize="10" FontWeight="SemiBold" Foreground="Gray"/>
                                    <TextBlock Grid.Column="2" Text="Service" FontSize="10" FontWeight="SemiBold" Foreground="Gray"/>
                                </Grid>
                            </Border>
                            <ListView x:Name="ScanResults" Grid.Row="1" SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="12,4"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Port}" FontSize="12"
                                                       FontFamily="Consolas" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <TextBlock Grid.Column="1" Text="OPEN" FontSize="11"
                                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Service}"
                                                       FontSize="11" Foreground="Gray"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" CornerRadius="6" Padding="10,6"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <TextBlock x:Name="ScanStatus" FontSize="11" Foreground="Gray"
                                   Text="Ready — enter a host and port range, then click Scan"/>
                    </Border>
                </Grid>
            </TabViewItem>

            <!-- ═══ OPEN PORTS (local) ══════════════════════════════════════ -->
            <TabViewItem Header="&#xE8F6;  Open Ports">
                <Grid RowSpacing="10" Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="&#xE72C;  Refresh" Click="OnRefreshPorts" Padding="12,7"/>
                        <ComboBox x:Name="PortProtoFilter" SelectedIndex="0" Width="120">
                            <ComboBoxItem Content="TCP + UDP"/>
                            <ComboBoxItem Content="TCP only"/>
                            <ComboBoxItem Content="UDP only"/>
                        </ComboBox>
                        <TextBox x:Name="PortSearch" PlaceholderText="Filter by port or process…"
                                 Width="220" TextChanged="OnPortSearchChanged"/>
                    </StackPanel>

                    <Border Grid.Row="1" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Padding="12,6" CornerRadius="8,8,0,0"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Proto"   FontSize="10" FontWeight="SemiBold" Foreground="Gray"/>
                                    <TextBlock Grid.Column="1" Text="Local Port" FontSize="10" FontWeight="SemiBold" Foreground="Gray"/>
                                    <TextBlock Grid.Column="2" Text="Local Address" FontSize="10" FontWeight="SemiBold" Foreground="Gray"/>
                                    <TextBlock Grid.Column="3" Text="Remote Address" FontSize="10" FontWeight="SemiBold" Foreground="Gray"/>
                                    <TextBlock Grid.Column="4" Text="State"   FontSize="10" FontWeight="SemiBold" Foreground="Gray"/>
                                    <TextBlock Grid.Column="5" Text="Process" FontSize="10" FontWeight="SemiBold" Foreground="Gray"/>
                                </Grid>
                            </Border>
                            <ListView x:Name="OpenPortsList" Grid.Row="1" SelectionMode="Single">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="12,5"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="55"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="140"/>
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="3" Padding="4,1" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Protocol}" FontSize="10"
                                                           FontWeight="SemiBold" FontFamily="Consolas"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding LocalPort}"
                                                       FontSize="12" FontFamily="Consolas"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="2" Text="{Binding LocalAddress}"
                                                       FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="3" Text="{Binding RemoteAddress}"
                                                       FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="4" Text="{Binding State}"
                                                       FontSize="10" Foreground="Gray"/>
                                            <TextBlock Grid.Column="5" Text="{Binding ProcessName}"
                                                       FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </TabViewItem>

        </TabView>
    </Grid>
</Window>
