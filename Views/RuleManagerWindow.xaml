<Window
    x:Class="WinNetControl.Views.RuleManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Rule Manager">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Padding="12" Spacing="8">
            <FontIcon Glyph="&#xE81E;" FontSize="20"/>
            <TextBlock Text="Advanced Rule Manager" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="12">
            <StackPanel Spacing="20">
                <!-- Templates -->
                <StackPanel Spacing="10">
                    <TextBlock Text="Rule Templates" FontSize="16" FontWeight="SemiBold"/>
                    <Border Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Spacing="10">
                            <CheckBox x:Name="BlockTelemetryCheck" Content="Block Known Windows Telemetry IPs" Checked="OnTemplateChecked" Unchecked="OnTemplateChecked"/>
                            <CheckBox x:Name="BlockSocialMediaCheck" Content="Block Common Social Media Networks" Checked="OnTemplateChecked" Unchecked="OnTemplateChecked"/>
                            <CheckBox x:Name="BlockAdsCheck" Content="Block Ad/Tracking Domains (via Hosts)" Checked="OnTemplateChecked" Unchecked="OnTemplateChecked"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Scheduled Rules -->
                <StackPanel Spacing="10">
                    <TextBlock Text="Scheduled Rules" FontSize="16" FontWeight="SemiBold"/>
                    <Border Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Block internet access on a schedule." Foreground="Gray"/>
                            <Grid ColumnSpacing="10" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="Start Time:" VerticalAlignment="Center"/>
                                <TimePicker x:Name="StartTimePicker" Grid.Column="1"/>
                                
                                <TextBlock Text="End Time:" Grid.Column="2" VerticalAlignment="Center"/>
                                <TimePicker x:Name="EndTimePicker" Grid.Column="3"/>
                            </Grid>
                            <Button Content="Apply Schedule Block" Click="OnApplySchedule" Margin="0,10,0,0"/>
                            <TextBlock x:Name="ScheduleStatusText" Foreground="LimeGreen" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
