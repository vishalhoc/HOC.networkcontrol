<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinNetControl.Pages.IpConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="20,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border CornerRadius="10" Padding="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE774;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="IP Configuration" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="ipconfig · ARP · Routing Table · DHCP · DNS" FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Padding="10,6" Click="OnRefresh">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                            <TextBlock Text="Refresh" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Padding="10,6" Click="OnCopy">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8C8;" FontSize="13"/>
                            <TextBlock Text="Copy" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="12" Margin="16,14,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tool selector -->
            <Border Grid.Column="0" CornerRadius="12" Padding="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="0">
                    <Border Padding="14,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Commands" FontSize="13" FontWeight="SemiBold"/>
                    </Border>
                    <ListView x:Name="CommandList" SelectionMode="Single"
                              SelectionChanged="OnCommandSelected">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="14,10"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListViewItem Tag="ipconfig /all" IsSelected="True">
                            <StackPanel Spacing="2">
                                <TextBlock Text="ipconfig /all" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Full adapter info" FontSize="10" Foreground="Gray"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="arp -a">
                            <StackPanel Spacing="2">
                                <TextBlock Text="arp -a" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="ARP cache table" FontSize="10" Foreground="Gray"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="route print">
                            <StackPanel Spacing="2">
                                <TextBlock Text="route print" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Routing table" FontSize="10" Foreground="Gray"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="netstat -an">
                            <StackPanel Spacing="2">
                                <TextBlock Text="netstat -an" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Active connections" FontSize="10" Foreground="Gray"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="netstat -b">
                            <StackPanel Spacing="2">
                                <TextBlock Text="netstat -b" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Connections + PID" FontSize="10" Foreground="Gray"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="ipconfig /displaydns">
                            <StackPanel Spacing="2">
                                <TextBlock Text="ipconfig /displaydns" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="DNS resolver cache" FontSize="10" Foreground="Gray"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="ipconfig /flushdns">
                            <StackPanel Spacing="2">
                                <TextBlock Text="ipconfig /flushdns" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Flush DNS cache" FontSize="10" Foreground="Gray"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="ipconfig /release">
                            <StackPanel Spacing="2">
                                <TextBlock Text="ipconfig /release" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Release DHCP" FontSize="10" Foreground="Gray"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="ipconfig /renew">
                            <StackPanel Spacing="2">
                                <TextBlock Text="ipconfig /renew" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Renew DHCP" FontSize="10" Foreground="Gray"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="ipconfig /registerdns">
                            <StackPanel Spacing="2">
                                <TextBlock Text="ipconfig /registerdns" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Register DNS" FontSize="10" Foreground="Gray"/>
                            </StackPanel>
                        </ListViewItem>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Output -->
            <Border Grid.Column="1" CornerRadius="12"
                    Background="#0A000000"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="14,8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                        <Grid>
                            <TextBlock x:Name="CmdLabel" Text="ipconfig /all"
                                       FontFamily="Cascadia Code, Consolas" FontSize="12"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <ProgressBar x:Name="CmdProgress" HorizontalAlignment="Right" Width="100"
                                         Height="4" IsIndeterminate="True" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <TextBlock x:Name="OutputText"
                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="12" TextWrapping="NoWrap"
                                   IsTextSelectionEnabled="True"
                                   Padding="16,12"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
