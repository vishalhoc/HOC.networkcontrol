<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinNetControl.Pages.OptimizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border CornerRadius="10" Padding="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xEC4A;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Network Optimizer" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="TCP/IP · Nagle · Autotuning · DNS cache · Receive window" FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Padding="12,6" Click="OnCheckStatus" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                        <TextBlock Text="Check Status" FontSize="12"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14" Padding="16,14,16,24">

                <!-- Warning -->
                <Border CornerRadius="10" Padding="14"
                        Background="#1AFBBC05"
                        BorderBrush="#40FBBC05" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE7BA;" FontSize="20" Foreground="#FBBC05" VerticalAlignment="Center"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                            Text="Administrator rights required. Some tweaks apply immediately; others need a restart. A system restore point is recommended before applying."/>
                    </StackPanel>
                </Border>

                <!-- One-click full optimize -->
                <Button HorizontalAlignment="Stretch" Padding="18,14" Click="OnFullOptimize">
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xEC4A;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <StackPanel>
                            <TextBlock Text="Apply All Optimizations" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Applies all tweaks below in one click" FontSize="11" Foreground="Gray"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- Tweaks grid -->
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>

                    <!-- TCP Autotuning -->
                    <Border CornerRadius="10" Padding="14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="TCP Receive Window Autotuning" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                                Text="Controls how Windows adjusts the receive buffer. 'Normal' is best for most connections."/>
                            <TextBlock x:Name="AutotuneStatus" Text="" FontSize="11" Foreground="#107C10"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Padding="8,5" FontSize="11" Click="OnTweak" Tag="autotune_normal">Normal</Button>
                                <Button Padding="8,5" FontSize="11" Click="OnTweak" Tag="autotune_disabled">Disabled</Button>
                                <Button Padding="8,5" FontSize="11" Click="OnTweak" Tag="autotune_restricted">Restricted</Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Nagle's Algorithm -->
                    <Border Grid.Column="1" CornerRadius="10" Padding="14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Nagle's Algorithm" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                                Text="Bundles small packets to reduce network overhead. Disable for gaming/interactive apps to reduce latency."/>
                            <TextBlock x:Name="NagleStatus" Text="" FontSize="11" Foreground="#107C10"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Padding="8,5" FontSize="11" Click="OnTweak" Tag="nagle_disable">Disable (Gaming)</Button>
                                <Button Padding="8,5" FontSize="11" Click="OnTweak" Tag="nagle_enable">Enable (Default)</Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- DNS Cache TTL -->
                    <Border Grid.Row="1" CornerRadius="10" Padding="14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="DNS Cache TTL" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                                Text="Sets how long resolved DNS entries are cached. Higher = faster browsing but stale entries."/>
                            <TextBlock x:Name="DnsCacheStatus" Text="" FontSize="11" Foreground="#107C10"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Padding="8,5" FontSize="11" Click="OnTweak" Tag="dnscache_max">Max (3600s)</Button>
                                <Button Padding="8,5" FontSize="11" Click="OnTweak" Tag="dnscache_default">Default (86400s)</Button>
                                <Button Padding="8,5" FontSize="11" Click="OnTweak" Tag="dnscache_low">Low (300s)</Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Network Throttling Index -->
                    <Border Grid.Row="1" Grid.Column="1" CornerRadius="10" Padding="14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Network Throttling Index" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                                Text="Windows limits multimedia packets to 10/s by default. Disable throttling for gaming or high-throughput."/>
                            <TextBlock x:Name="ThrottleStatus" Text="" FontSize="11" Foreground="#107C10"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Padding="8,5" FontSize="11" Click="OnTweak" Tag="throttle_off">Disable (Gaming)</Button>
                                <Button Padding="8,5" FontSize="11" Click="OnTweak" Tag="throttle_on">Enable (Default)</Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- TCP Timestamps -->
                    <Border Grid.Row="2" CornerRadius="10" Padding="14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="TCP Timestamps" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                                Text="Adds timestamps to TCP packets. Slightly increases overhead. Disable for marginal speed gains."/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Padding="8,5" FontSize="11" Click="OnTweak" Tag="timestamps_off">Disable</Button>
                                <Button Padding="8,5" FontSize="11" Click="OnTweak" Tag="timestamps_on">Enable (Default)</Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- RSS -->
                    <Border Grid.Row="2" Grid.Column="1" CornerRadius="10" Padding="14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Receive Side Scaling (RSS)" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                                Text="Distributes network receive processing across multiple CPU cores for higher throughput."/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Padding="8,5" FontSize="11" Click="OnTweak" Tag="rss_on">Enable (Recommended)</Button>
                                <Button Padding="8,5" FontSize="11" Click="OnTweak" Tag="rss_off">Disable</Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ECN -->
                    <Border Grid.Row="3" CornerRadius="10" Padding="14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="ECN Capability" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                                Text="Explicit Congestion Notification. Can reduce packet loss on congested links."/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Padding="8,5" FontSize="11" Click="OnTweak" Tag="ecn_on">Enable</Button>
                                <Button Padding="8,5" FontSize="11" Click="OnTweak" Tag="ecn_off">Disable (Default)</Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Chimney Offload -->
                    <Border Grid.Row="3" Grid.Column="1" CornerRadius="10" Padding="14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="TCP Chimney Offload" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                                Text="Offloads TCP processing to the NIC. Can improve CPU usage on high-throughput links."/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Padding="8,5" FontSize="11" Click="OnTweak" Tag="chimney_on">Enable</Button>
                                <Button Padding="8,5" FontSize="11" Click="OnTweak" Tag="chimney_off">Disable (Default)</Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Apply log -->
                <Border CornerRadius="10" Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Action Log" FontSize="12" FontWeight="SemiBold"/>
                        <ScrollViewer Height="120" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="OptLog" FontFamily="Consolas" FontSize="11"
                                       IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                       Text="Ready. Apply tweaks above to see results."/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
