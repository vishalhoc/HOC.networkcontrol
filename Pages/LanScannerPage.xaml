<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinNetControl.Pages.LanScannerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border CornerRadius="10" Padding="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE9F5;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="LAN Scanner" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Discover devices and manage this PC's access to them" FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="ScanStatusText" VerticalAlignment="Center"
                               FontSize="11" Foreground="Gray"/>
                    <Button x:Name="ScanBtn" Padding="12,6" Click="OnScanToggle"
                            Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="ScanIcon" Glyph="&#xE968;" FontSize="13"/>
                            <TextBlock x:Name="ScanBtnText" Text="Scan Network"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" RowSpacing="12" Margin="16,14,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Scan config row -->
            <Border Grid.Row="0" CornerRadius="10" Padding="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SubnetBox" Header="IP Range" PlaceholderText="192.168.1.0/24" Text="192.168.1.0/24"/>
                    <NumberBox x:Name="TimeoutBox" Grid.Column="1" Header="Timeout (ms)"
                               Value="500" Minimum="100" Maximum="3000" SpinButtonPlacementMode="Inline"/>
                    <ToggleSwitch x:Name="ResolveNames" Grid.Column="2" Header="Hostname Lookup"
                                  IsOn="True" VerticalAlignment="Bottom"/>
                    <ToggleSwitch x:Name="ScanPorts" Grid.Column="3" Header="Port Probe"
                                  IsOn="False" VerticalAlignment="Bottom"/>
                    <ToggleSwitch x:Name="DiscoverServices" Grid.Column="4" Header="Find smart devices"
                                  IsOn="True" VerticalAlignment="Bottom"
                                  ToolTipService.ToolTip="Uses UPnP/SSDP to discover device names, models, and types"/>
                </Grid>
            </Border>

            <!-- Summary row -->
            <Grid Grid.Row="1" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="8" Padding="12,8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Hosts Discovered" FontSize="10" Foreground="Gray"/>
                        <TextBlock x:Name="StatHosts" Text="0" FontSize="18" FontWeight="Bold"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" CornerRadius="8" Padding="12,8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Scanned" FontSize="10" Foreground="Gray"/>
                        <TextBlock x:Name="StatScanned" Text="0 / 0" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" CornerRadius="8" Padding="12,8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Elapsed" FontSize="10" Foreground="Gray"/>
                        <TextBlock x:Name="StatElapsed" Text="0 s" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" CornerRadius="8" Padding="12,8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Scan Progress" FontSize="10" Foreground="Gray"/>
                        <ProgressBar x:Name="ScanProgressBar" Height="8" CornerRadius="4"
                                     Maximum="100" Value="0" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Device list -->
            <Border Grid.Row="2" CornerRadius="12" Padding="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Device controls -->
                    <Border Grid.Row="0" Padding="14,10"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Devices" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox x:Name="DeviceSearchBox" Width="200" PlaceholderText="Filter IP, name, or MAC…"
                                         TextChanged="OnDeviceSearchChanged"/>
                                <ToggleSwitch x:Name="BlockedOnlyToggle" Header="Blocked only" Toggled="OnBlockedOnlyToggled"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button Padding="8,5" Click="OnPingSelected" ToolTipService.ToolTip="Ping the selected device">
                                    <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE879;" FontSize="12"/><TextBlock Text="Ping" FontSize="11"/></StackPanel>
                                </Button>
                                <Button Padding="8,5" Click="OnBlockSelected" ToolTipService.ToolTip="Block selected devices from this PC">
                                    <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xF140;" FontSize="12" Foreground="#CC3300"/><TextBlock Text="Block Selected" FontSize="11"/></StackPanel>
                                </Button>
                                <Button Padding="8,5" Click="OnUnblockSelected" ToolTipService.ToolTip="Restore this PC's access to selected devices">
                                    <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE785;" FontSize="12"/><TextBlock Text="Unblock" FontSize="11"/></StackPanel>
                                </Button>
                                <Button Padding="8,5" Click="OnExportDevices" ToolTipService.ToolTip="Export visible devices to CSV">
                                    <FontIcon Glyph="&#xE898;" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Column headers -->
                    <Border Grid.Row="1" Padding="14,10"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="145"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="IP Address" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Hostname" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="Type / Vendor" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="MAC Address" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="Ping" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="5" Text="Open Ports" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="6" Text="Access" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>

                    <ListView x:Name="DeviceList" Grid.Row="2" SelectionMode="Multiple">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="14,8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Device details" Click="OnShowDeviceDetails" Tag="{Binding}"/>
                                            <MenuFlyoutItem Text="Ping now" Click="OnPingDevice" Tag="{Binding}"/>
                                            <MenuFlyoutItem Text="Copy IP" Click="OnCopyDeviceIp" Tag="{Binding}"/>
                                            <MenuFlyoutItem Text="Copy MAC" Click="OnCopyDeviceMac" Tag="{Binding}"/>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="145"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Ip}"
                                               FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Hostname}"
                                               FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TypeVendorText}"
                                               FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{Binding DeviceDetails}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Mac}"
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="Gray" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding PingMs}"
                                               FontSize="12" VerticalAlignment="Center"
                                               Foreground="{Binding PingBrush}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding OpenPorts}"
                                               FontSize="11" Foreground="Gray" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="6" Padding="8,4" Click="OnDeviceAccessToggle"
                                            Tag="{Binding}" ToolTipService.ToolTip="Blocks only this PC's traffic to and from the device">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="{Binding AccessIcon}" FontSize="11" Foreground="{Binding AccessBrush}"/>
                                            <TextBlock Text="{Binding AccessText}" FontSize="11" Foreground="{Binding AccessBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
