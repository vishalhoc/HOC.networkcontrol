<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinNetControl.Pages.ConnectionManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinNetControl.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- Converters are declared globally in App.xaml and resolved via StaticResource -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Row 0: Action toolbar -->
            <RowDefinition Height="Auto"/>  <!-- Row 1: Filter / Sort / Search -->
            <RowDefinition Height="Auto"/>  <!-- Row 2: Stats bar -->
            <RowDefinition Height="*"/>     <!-- Row 3: Process list -->
        </Grid.RowDefinitions>

        <!-- ══ ROW 0 — Action Toolbar ══ -->
        <Grid Grid.Row="0" Padding="10,5" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left: page title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE9CE;" FontSize="16"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="Connection Manager"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="— Monitor and control all app network traffic"
                           FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Right: action buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">

                <!-- Show offline blocked apps -->
                <ToggleButton IsChecked="{x:Bind ViewModel.ShowOfflineBlockedApps, Mode=TwoWay}"
                              ToolTipService.ToolTip="Show blocked apps even when offline"
                              Padding="8,6">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xEA8A;" FontSize="14"/>
                        <TextBlock Text="Offline" FontSize="12"/>
                    </StackPanel>
                </ToggleButton>

                <!-- Windows Network Tools flyout -->
                <Button Padding="8,6" ToolTipService.ToolTip="Windows Network Tools">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE774;" FontSize="14"/>
                        <TextBlock Text="Net Tools" FontSize="12"/>
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Adapter Manager" Click="OnAdapterManagerClicked">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE839;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Network Tools (Ping / Trace / Scan)" Click="OnNetworkToolsClicked">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9CE;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Windows Firewall" Click="OnOpenWindowsFirewall">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7BA;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Network Connections (ncpa.cpl)" Click="OnOpenNetworkConnections">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE839;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Network Settings" Click="OnOpenNetworkSettings">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE703;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Network Troubleshooter" Click="OnOpenNetworkTroubleshooter">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9CE;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Flush DNS Cache" Click="OnFlushDnsClicked">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Local Network Scanner" Click="OnLocalScannerClicked">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE968;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Block Entire Subnet" Click="OnBlockSubnetClicked">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE730;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Advanced Rule Manager" Click="OnRuleManagerClicked">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81E;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="History Log" Click="OnHistoryLogClicked">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Internet Reset…" Click="OnResetInternetClicked">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE777;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- Reset Data -->
                <Button Padding="8,6" Click="OnResetDataClicked" ToolTipService.ToolTip="Reset all data usage counters">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                        <TextBlock Text="Reset" FontSize="12"/>
                    </StackPanel>
                </Button>

                <!-- Export CSV -->
                <Button Padding="8,6" Click="OnExportCsvClicked" ToolTipService.ToolTip="Export stats to CSV (Desktop)">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE7C3;" FontSize="13"/>
                        <TextBlock Text="Export" FontSize="12"/>
                    </StackPanel>
                </Button>

                <!-- Bulk Actions -->
                <Button Padding="8,6" Click="OnBulkSelectAll" ToolTipService.ToolTip="Select / deselect all visible apps">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE73A;" FontSize="13"/>
                        <TextBlock Text="Select All" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button Padding="8,6" Click="OnBulkBlock"
                        ToolTipService.ToolTip="Block all checked apps at once"
                        Background="#CC3300">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xF140;" FontSize="13" Foreground="White"/>
                        <TextBlock Text="Block Selected" FontSize="12" Foreground="White"/>
                    </StackPanel>
                </Button>
                <Button Padding="8,6" Click="OnBulkUnblock"
                        ToolTipService.ToolTip="Unblock all checked apps at once">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE785;" FontSize="13"/>
                        <TextBlock Text="Unblock Selected" FontSize="12"/>
                    </StackPanel>
                </Button>

                <!-- HTTP Inspector -->
                <Button Padding="8,6" Click="OnHttpInspectorClicked" ToolTipService.ToolTip="HTTP Inspector">
                    <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                </Button>

                <!-- Export Rules -->
                <Button Padding="8,6" Click="OnExportRulesClicked"
                        ToolTipService.ToolTip="Export all WinNetControl firewall rules to Desktop">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xEDE1;" FontSize="13"/>
                        <TextBlock Text="Export Rules" FontSize="12"/>
                    </StackPanel>
                </Button>

                <!-- Import Rules -->
                <Button Padding="8,6" Click="OnImportRulesClicked"
                        ToolTipService.ToolTip="Import WinNetControl firewall rules from Desktop backup">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE896;" FontSize="13"/>
                        <TextBlock Text="Import Rules" FontSize="12"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Grid>

        <!-- ══ ROW 1 — Filter / Sort / Search / Protocol bar ══ -->
        <Border Grid.Row="1" Padding="12,6,12,6"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">

                <!-- Filter -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE71C;" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                    <TextBlock Text="Filter:" FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{x:Bind ViewModel.Filters}"
                              SelectedItem="{x:Bind ViewModel.SelectedFilter, Mode=TwoWay}"
                              Width="140" Height="32"/>
                </StackPanel>

                <Rectangle Width="1" Height="22" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center"/>

                <!-- Sort By -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8CB;" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                    <TextBlock Text="Sort:" FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{x:Bind ViewModel.SortOptions}"
                              SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}"
                              Width="170" Height="32"/>
                </StackPanel>

                <Rectangle Width="1" Height="22" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center"/>

                <!-- Search -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE721;" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                    <AutoSuggestBox x:Name="SearchBox"
                                    PlaceholderText="Search process name…"
                                    Width="200" Height="32"
                                    QueryIcon="Find"
                                    TextChanged="OnSearchTextChanged_Auto"/>
                </StackPanel>

                <Rectangle Width="1" Height="22" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center"/>

                <!-- Protocol -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE839;" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                    <TextBlock Text="Protocol:" FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{x:Bind ViewModel.ProtocolFilters}"
                              SelectedItem="{x:Bind ViewModel.SelectedProtocol, Mode=TwoWay}"
                              Width="110" Height="32"/>
                </StackPanel>

                <Rectangle Width="1" Height="22" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center"/>

                <!-- Clear Filters -->
                <Button Padding="6,4" VerticalAlignment="Center"
                        Click="OnClearSearchClicked"
                        ToolTipService.ToolTip="Clear filters">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE894;" FontSize="12"/>
                        <TextBlock Text="Clear" FontSize="11"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>

        <!-- ══ ROW 2 — Global Stats Bar ══ -->
        <Border Grid.Row="2" Margin="12,4,12,4" Padding="14,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Upload -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" Margin="0,0,20,0">
                    <FontIcon Glyph="&#xE898;" FontSize="14" Foreground="#0078D4"/>
                    <TextBlock Text="↑" Foreground="#0078D4" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.GlobalUploadText, Mode=OneWay}"
                               Foreground="#0078D4" FontWeight="SemiBold" VerticalAlignment="Center"
                               MinWidth="90"/>
                </StackPanel>

                <!-- Download -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="0,0,20,0">
                    <FontIcon Glyph="&#xE896;" FontSize="14" Foreground="#107C10"/>
                    <TextBlock Text="↓" Foreground="#107C10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.GlobalDownloadText, Mode=OneWay}"
                               Foreground="#107C10" FontWeight="SemiBold" VerticalAlignment="Center"
                               MinWidth="90"/>
                </StackPanel>

                <!-- Total -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" Margin="0,0,20,0">
                    <FontIcon Glyph="&#xE7C8;" FontSize="14" Opacity="0.6"/>
                    <TextBlock Text="Total:" VerticalAlignment="Center" Foreground="Gray" FontSize="12"/>
                    <TextBlock Text="{x:Bind ViewModel.GlobalTotalText, Mode=OneWay}" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>

                <!-- Spacer -->
                <Rectangle Grid.Column="3"/>

                <!-- Session time -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="5" Margin="0,0,16,0">
                    <FontIcon Glyph="&#xE916;" FontSize="13" Opacity="0.6"/>
                    <TextBlock Text="Session:" VerticalAlignment="Center" Foreground="Gray" FontSize="12"/>
                    <TextBlock Text="{x:Bind ViewModel.SessionDuration, Mode=OneWay}"
                               VerticalAlignment="Center" FontSize="12" FontFamily="Consolas"/>
                </StackPanel>

                <!-- Blocked count -->
                <Border Grid.Column="5" CornerRadius="12" Padding="10,3" VerticalAlignment="Center" Margin="0,0,12,0"
                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xF140;" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.BlockedCountText, Mode=OneWay}"
                                   VerticalAlignment="Center" FontSize="11"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Process count -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE9CE;" FontSize="12" Opacity="0.5"/>
                    <TextBlock VerticalAlignment="Center" Foreground="Gray" FontSize="11"
                               Text="{x:Bind ViewModel.FilteredProcesses.Count, Mode=OneWay}"/>
                    <TextBlock Text="apps" VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
                </StackPanel>

                <!-- Top 5 Bandwidth Consumers button -->
                <Button Grid.Column="7" Padding="8,3" VerticalAlignment="Center" Margin="8,0,0,0"
                        ToolTipService.ToolTip="Top bandwidth consumers">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="280" Spacing="6" Padding="4">
                                <TextBlock Text="🏆  Top Bandwidth Consumers" FontWeight="SemiBold" FontSize="13"/>
                                <ListView ItemsSource="{x:Bind ViewModel.TopConsumers, Mode=OneWay}"
                                          SelectionMode="None" MaxHeight="220">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="0,2"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="72"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ProcessName}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding TotalDataUsed, Converter={StaticResource SizeConverter}}"
                                                           FontSize="11" Foreground="{Binding DataUsageTier, Converter={StaticResource DataUsageTierToBrushConverter}}"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE734;" FontSize="11"/>
                        <TextBlock Text="Top 5" FontSize="11"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ══ ROW 3 — Process List ══ -->
        <Grid Grid.Row="3" Margin="12,0,12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Column headers -->
            <Grid Grid.Row="0" Margin="40,2,4,2" Padding="0,2" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"  Text="☑"           FontWeight="SemiBold" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"  Text="Application ↕" Tag="Name (A-Z)"
                           FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="11" VerticalAlignment="Center"
                           Tapped="OnSortHeaderTapped" ToolTipService.ToolTip="Click to sort by Name"/>
                <TextBlock Grid.Column="2"  Text="Adapter"      FontWeight="SemiBold" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3"  Text="Type"         FontWeight="SemiBold" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4"  Text="↑ Upload ↕"  Tag="Upload Speed"
                           FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="11" VerticalAlignment="Center"
                           Tapped="OnSortHeaderTapped"/>
                <TextBlock Grid.Column="5"  Text="↓ Download ↕" Tag="Download Speed"
                           FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="11" VerticalAlignment="Center"
                           Tapped="OnSortHeaderTapped"/>
                <TextBlock Grid.Column="6"  Text="Data ↕"       Tag="Data Used (High-Low)"
                           FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="11" VerticalAlignment="Center"
                           Tapped="OnSortHeaderTapped"/>
                <TextBlock Grid.Column="7"  Text="Graph"        FontWeight="SemiBold" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="8"  Text="Widget"       FontWeight="SemiBold" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="9"  Text="Blk In/Out"   FontWeight="SemiBold" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="10" Text="Pin"          FontWeight="SemiBold" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="11" Text="HTTP"         FontWeight="SemiBold" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="12" Text="Block All"    FontWeight="SemiBold" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
            </Grid>

            <!-- Process list -->
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.FilteredProcesses, Mode=OneWay}"
                      SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <Grid HorizontalAlignment="Stretch" ColumnSpacing="6" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Bulk select checkbox -->
                                    <ToggleButton Grid.Column="0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  Width="22" Height="22" MinWidth="0" Padding="0"
                                                  BorderThickness="1" CornerRadius="3"
                                                  Tapped="OnRowCheckboxTapped">
                                        <ToggleButton.Resources>
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#0078D4"/>
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#106EBE"/>
                                            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="White"/>
                                        </ToggleButton.Resources>
                                        <FontIcon Glyph="&#xE73E;" FontSize="11"/>
                                    </ToggleButton>

                                    <!-- App name + badges -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Image Source="{Binding AppIcon}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                                            <TextBlock Text="{Binding ConnectionStatsText}" FontSize="10" Foreground="Gray"/>
                                        </StackPanel>
                                        <TextBlock Text="⚠" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="#FBBC05" ToolTipService.ToolTip="Suspicious process"
                                                   Visibility="{Binding IsSuspicious, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <Border Visibility="{Binding IsPhantom, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Background="#CC3300" CornerRadius="4" Padding="4,1">
                                            <TextBlock Text="OFFLINE" FontSize="9" Foreground="White" FontWeight="Bold"/>
                                        </Border>
                                        <Border Visibility="{Binding IsDataLimitExceeded, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Background="#8B0000" CornerRadius="4" Padding="4,1">
                                            <TextBlock Text="LIMIT" FontSize="9" Foreground="White" FontWeight="Bold"/>
                                        </Border>
                                        <Border Visibility="{Binding DataUsageTier, Converter={StaticResource DataUsageTierToVisibilityConverter}}"
                                                Background="{Binding DataUsageTier, Converter={StaticResource DataUsageTierToBrushConverter}}"
                                                CornerRadius="4" Padding="4,1">
                                            <TextBlock Text="{Binding TotalDataUsed, Converter={StaticResource SizeConverter}}"
                                                       FontSize="9" Foreground="White" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Adapter name -->
                                    <TextBlock Grid.Column="2" Text="{Binding AdapterName}"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Column="3" Text="{Binding AppType}" Foreground="Gray" FontSize="11"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                    <!-- Upload speed + mini bar -->
                                    <Grid Grid.Column="4" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="3"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding UploadSpeed, Converter={StaticResource SpeedConverter}}"
                                                   Foreground="#0078D4" FontSize="12"/>
                                        <Border Grid.Row="1" CornerRadius="2" HorizontalAlignment="Left"
                                                Width="{Binding UploadSpeedRatio, Converter={StaticResource RatioToWidthConverter}, ConverterParameter=90}"
                                                Height="3" Background="#0078D4" Opacity="0.7"/>
                                    </Grid>

                                    <!-- Download speed + mini bar -->
                                    <Grid Grid.Column="5" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="3"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding DownloadSpeed, Converter={StaticResource SpeedConverter}}"
                                                   Foreground="#107C10" FontSize="12"/>
                                        <Border Grid.Row="1" CornerRadius="2" HorizontalAlignment="Left"
                                                Width="{Binding DownloadSpeedRatio, Converter={StaticResource RatioToWidthConverter}, ConverterParameter=90}"
                                                Height="3" Background="#107C10" Opacity="0.7"/>
                                    </Grid>

                                    <TextBlock Grid.Column="6" Text="{Binding TotalDataUsed, Converter={StaticResource SizeConverter}}"
                                               Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>

                                    <!-- Sparkline chart -->
                                    <controls:SparklineControl Grid.Column="7"
                                        SpeedSamples="{Binding SpeedHistory}"
                                        VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                    <!-- Widget toggle -->
                                    <ToggleButton Grid.Column="8" IsChecked="{Binding ShowFloatingWidget, Mode=TwoWay}"
                                                  Click="OnAppWidgetClicked" VerticalAlignment="Center" Padding="4,3"
                                                  ToolTipService.ToolTip="Per-app speed widget">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="13"/>
                                    </ToggleButton>

                                    <!-- Block In + Block Out buttons -->
                                    <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <ToggleButton IsChecked="{Binding BlockInbound, Mode=TwoWay}"
                                                      Click="OnBlockInboundToggled" Padding="4,3"
                                                      ToolTipService.ToolTip="Block Inbound (→ App)">
                                            <TextBlock Text="In" FontSize="11" FontWeight="SemiBold"/>
                                        </ToggleButton>
                                        <ToggleButton IsChecked="{Binding BlockOutbound, Mode=TwoWay}"
                                                      Click="OnBlockOutboundToggled" Padding="4,3"
                                                      ToolTipService.ToolTip="Block Outbound (App →)">
                                            <TextBlock Text="Out" FontSize="11" FontWeight="SemiBold"/>
                                        </ToggleButton>
                                    </StackPanel>

                                    <!-- Pin -->
                                    <ToggleButton Grid.Column="10" IsChecked="{Binding IsPinned, Mode=TwoWay}"
                                                  Click="OnPinToggled" VerticalAlignment="Center" Padding="4,3"
                                                  ToolTipService.ToolTip="Pin to top">
                                        <FontIcon Glyph="&#xE718;" FontSize="13"/>
                                    </ToggleButton>

                                    <!-- HTTP Capture -->
                                    <ToggleButton Grid.Column="11" IsChecked="{Binding IsHttpCaptureEnabled, Mode=TwoWay}"
                                                  Click="OnHttpCaptureToggled" VerticalAlignment="Center" Padding="4,3"
                                                  ToolTipService.ToolTip="HTTP Capture">
                                        <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                                    </ToggleButton>

                                    <!-- Block All toggle switch -->
                                    <ToggleSwitch Grid.Column="12" OffContent="" OnContent=""
                                                  IsOn="{Binding IsBlocked, Mode=TwoWay}"
                                                  Toggled="OnBlockToggled" VerticalAlignment="Center"/>
                                </Grid>
                            </Expander.Header>

                            <!-- Right-click context menu -->
                            <Expander.ContextFlyout>
                                <MenuFlyout Opening="OnProcessContextMenuOpening">
                                    <MenuFlyoutItem Text="Details…" Click="OnCtxDetails">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="Copy Name" Click="OnCtxCopyName">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Copy Path" Click="OnCtxCopyPath">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="Block All" Click="OnCtxBlock">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF140;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSubItem Text="Block Temporarily">
                                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE916;"/></MenuFlyoutSubItem.Icon>
                                        <MenuFlyoutItem Text="Block for 15 minutes"  Click="OnCtxBlockTemp" Tag="15"/>
                                        <MenuFlyoutItem Text="Block for 30 minutes"  Click="OnCtxBlockTemp" Tag="30"/>
                                        <MenuFlyoutItem Text="Block for 1 hour"      Click="OnCtxBlockTemp" Tag="60"/>
                                        <MenuFlyoutItem Text="Block for 2 hours"     Click="OnCtxBlockTemp" Tag="120"/>
                                        <MenuFlyoutItem Text="Block for 4 hours"     Click="OnCtxBlockTemp" Tag="240"/>
                                        <MenuFlyoutItem Text="Block for Custom time" Click="OnCtxBlockTempCustom"/>
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutItem Text="Unblock" Click="OnCtxUnblock">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE785;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="Block Domain in Hosts" Click="OnCtxBlockInHosts">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="Open Firewall Rules" Click="OnCtxOpenFirewall">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7BA;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="Kill Process" Click="OnCtxKill">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;" Foreground="Red"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Check on VirusTotal" Click="OnCtxVirusTotal">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B3;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Ping this Process Host" Click="OnCtxPingHost">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE879;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="Network Map" Click="OnCtxNetworkMap">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8EF;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Expander.ContextFlyout>

                            <!-- ══ Connection List ══ -->
                            <Expander.Content>
                                <StackPanel Spacing="4" Margin="8,4,0,4">
                                    <!-- Connection headers -->
                                    <Grid Margin="0,0,0,2" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Proto"      FontSize="10" FontWeight="SemiBold" Foreground="Gray" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Dir"      FontSize="10" FontWeight="SemiBold" Foreground="Gray" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="Local"    FontSize="10" FontWeight="SemiBold" Foreground="Gray" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="Remote"   FontSize="10" FontWeight="SemiBold" Foreground="Gray" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="State"    FontSize="10" FontWeight="SemiBold" Foreground="Gray" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="Speed"    FontSize="10" FontWeight="SemiBold" Foreground="Gray" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="Data"     FontSize="10" FontWeight="SemiBold" Foreground="Gray" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="7" Text="Blk In/Out" FontSize="10" FontWeight="SemiBold" Foreground="Gray" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="8" Text="Blk"      FontSize="10" FontWeight="SemiBold" Foreground="Gray" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="9" Text="📌"       FontSize="10" FontWeight="SemiBold" Foreground="Gray" VerticalAlignment="Center"/>
                                    </Grid>

                                    <ListView ItemsSource="{Binding Connections}" SelectionMode="None" MaxHeight="320">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding" Value="0,1"/>
                                                <Setter Property="MinHeight" Value="0"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="6" Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50"/>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="160"/>
                                                        <ColumnDefinition Width="160"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="76"/>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="32"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Protocol badge -->
                                                    <Border CornerRadius="4" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.15"/>
                                                        </Border.Background>
                                                        <TextBlock Text="{Binding Protocol}" FontSize="10" FontWeight="SemiBold"/>
                                                    </Border>

                                                    <!-- Direction badge -->
                                                    <Border Grid.Column="1" CornerRadius="4" Padding="3,1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                            Background="{Binding IsInbound, Converter={StaticResource BoolToBrushConverter}}">
                                                        <TextBlock Text="{Binding DirectionText}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="2" Text="{Binding LocalAddressPort}"  FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               Opacity="{Binding IsActive, Converter={StaticResource BoolToOpacityConverter}}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding RemoteAddressPort}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               Opacity="{Binding IsActive, Converter={StaticResource BoolToOpacityConverter}}">
                                                        <TextBlock.ContextFlyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem Text="Copy Remote Address" Click="OnCopyConnectionAddress">
                                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;"/></MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                            </MenuFlyout>
                                                        </TextBlock.ContextFlyout>
                                                    </TextBlock>

                                                    <!-- State badge -->
                                                    <Border Grid.Column="4" CornerRadius="4" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                            Background="{Binding NormalizedState, Converter={StaticResource StateToColorConverter}}"
                                                            ToolTipService.ToolTip="{Binding NormalizedState, Converter={StaticResource StateToDescriptionConverter}}">
                                                        <TextBlock Text="{Binding NormalizedState}"
                                                                   FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                                    </Border>

                                                    <!-- Speed -->
                                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                                                Opacity="{Binding IsActive, Converter={StaticResource BoolToOpacityConverter}}">
                                                        <TextBlock Foreground="#0078D4" FontSize="11">
                                                            <Run Text="↑"/><Run Text=" "/><Run Text="{Binding UploadSpeed, Converter={StaticResource SpeedConverter}}"/>
                                                        </TextBlock>
                                                        <TextBlock Foreground="#107C10" FontSize="11">
                                                            <Run Text="↓"/><Run Text=" "/><Run Text="{Binding DownloadSpeed, Converter={StaticResource SpeedConverter}}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- Data used -->
                                                    <TextBlock Grid.Column="6" Text="{Binding TotalDataUsed, Converter={StaticResource SizeConverter}}"
                                                               Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>

                                                    <!-- Per-connection Block In / Out -->
                                                    <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                        <ToggleButton IsChecked="{Binding BlockInbound, Mode=TwoWay}"
                                                                      Click="OnConnectionInboundBlockToggled" Padding="3,2"
                                                                      ToolTipService.ToolTip="Block inbound for this connection">
                                                            <TextBlock Text="In" FontSize="10"/>
                                                        </ToggleButton>
                                                        <ToggleButton IsChecked="{Binding BlockOutbound, Mode=TwoWay}"
                                                                      Click="OnConnectionOutboundBlockToggled" Padding="3,2"
                                                                      ToolTipService.ToolTip="Block outbound for this connection">
                                                            <TextBlock Text="Out" FontSize="10"/>
                                                        </ToggleButton>
                                                    </StackPanel>

                                                    <!-- Block all (this connection) -->
                                                    <ToggleButton Grid.Column="8" IsChecked="{Binding IsBlocked, Mode=TwoWay}"
                                                                  Click="OnConnectionBlockToggled" VerticalAlignment="Center" Padding="4,2"
                                                                  ToolTipService.ToolTip="Block all traffic for this connection">
                                                        <FontIcon Glyph="&#xF140;" FontSize="11"/>
                                                    </ToggleButton>

                                                    <!-- Pin this connection -->
                                                    <ToggleButton Grid.Column="9" IsChecked="{Binding IsPinned, Mode=TwoWay}"
                                                                  Click="OnConnectionPinToggled" VerticalAlignment="Center" Padding="4,2"
                                                                  ToolTipService.ToolTip="Pin connection to top">
                                                        <FontIcon Glyph="&#xE718;" FontSize="11"/>
                                                    </ToggleButton>

                                                    <!-- Right-click context on connection row -->
                                                    <Grid.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Copy Remote Address" Click="OnCopyConnectionAddress">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;"/></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Block Domain in Hosts" Click="OnConnectionBlockInHosts">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;"/></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </Grid.ContextFlyout>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <!-- App Notes -->
                                    <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Add custom notes or context for this application..."
                                             FontSize="11"
                                             Margin="0,4,0,0"
                                             LostFocus="OnAppNotesLostFocus"/>
                                </StackPanel>
                            </Expander.Content>
                        </Expander>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
