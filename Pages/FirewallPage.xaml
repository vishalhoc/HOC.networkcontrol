<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinNetControl.Pages.FirewallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border CornerRadius="10" Padding="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xEA18;" FontSize="22" Foreground="#E02020"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Firewall Manager" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Rules · App blocking · Port rules · Profile control" FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Padding="10,6" Click="OnOpenWindowsFirewall">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8A7;" FontSize="13"/>
                            <TextBlock Text="Open wf.msc" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Padding="10,6" Click="OnRefreshRules">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                            <TextBlock Text="Refresh" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="12" Margin="16,14,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: quick actions + profile control -->
            <StackPanel Grid.Column="0" Spacing="12">

                <!-- Firewall profiles -->
                <Border CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Firewall Profiles" FontSize="13" FontWeight="SemiBold"/>
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Domain" FontSize="12" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Padding="8,4" FontSize="11" Margin="0,0,4,0"
                                    Click="OnProfileOn" Tag="domain">On</Button>
                            <Button Grid.Column="2" Padding="8,4" FontSize="11"
                                    Click="OnProfileOff" Tag="domain">Off</Button>

                            <TextBlock Grid.Row="1" Text="Private" FontSize="12" VerticalAlignment="Center"/>
                            <Button Grid.Row="1" Grid.Column="1" Padding="8,4" FontSize="11" Margin="0,0,4,0"
                                    Click="OnProfileOn" Tag="private">On</Button>
                            <Button Grid.Row="1" Grid.Column="2" Padding="8,4" FontSize="11"
                                    Click="OnProfileOff" Tag="private">Off</Button>

                            <TextBlock Grid.Row="2" Text="Public" FontSize="12" VerticalAlignment="Center"/>
                            <Button Grid.Row="2" Grid.Column="1" Padding="8,4" FontSize="11" Margin="0,0,4,0"
                                    Click="OnProfileOn" Tag="public">On</Button>
                            <Button Grid.Row="2" Grid.Column="2" Padding="8,4" FontSize="11"
                                    Click="OnProfileOff" Tag="public">Off</Button>
                        </Grid>
                        <Button HorizontalAlignment="Stretch" Padding="10,6" Click="OnEnableAll"
                                Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE73E;" FontSize="13"/>
                                <TextBlock Text="Enable All Profiles"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Add rule -->
                <Border CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Add Custom Rule" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox x:Name="RuleNameBox" Header="Rule Name" PlaceholderText="My rule"/>
                        <ComboBox x:Name="RuleDirection" Header="Direction" HorizontalAlignment="Stretch" SelectedIndex="0">
                            <ComboBoxItem Content="Outbound (block)"/>
                            <ComboBoxItem Content="Inbound (block)"/>
                        </ComboBox>
                        <TextBox x:Name="RuleRemoteIp" Header="Remote IP (optional)" PlaceholderText="e.g. 1.2.3.4"/>
                        <NumberBox x:Name="RulePort" Header="Port (0 = any)"
                                   Value="0" Minimum="0" Maximum="65535" SpinButtonPlacementMode="Inline"/>
                        <TextBox x:Name="RuleProgram" Header="Program path (optional)"
                                 PlaceholderText="C:\path\to\app.exe"/>
                        <Button HorizontalAlignment="Stretch" Padding="10,6"
                                Click="OnAddRule" Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="13"/>
                                <TextBlock Text="Add Rule"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="RuleStatus" Text="" FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Quick actions -->
                <Border CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Quick Actions" FontSize="13" FontWeight="SemiBold"/>
                        <Button HorizontalAlignment="Stretch" Padding="10,6" Click="OnResetDefaults">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE777;" FontSize="13" Foreground="#FBBC05"/>
                                <TextBlock Text="Reset to Defaults"/>
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" Padding="10,6" Click="OnDeleteAllWnc">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#E02020"/>
                                <TextBlock Text="Delete All WNC Rules"/>
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" Padding="10,6" Click="OnExportRules">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE898;" FontSize="13"/>
                                <TextBlock Text="Export Rules (JSON)"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right: WNC rules list -->
            <Border Grid.Column="1" CornerRadius="12" Padding="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title + search -->
                    <Border Grid.Row="0" Padding="16,12"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="WinNetControl Firewall Rules" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="QuickBlockIpBox" Width="180" PlaceholderText="Block IP…"/>
                                <Button Padding="8,4" FontSize="11" Click="OnQuickBlockIp" ToolTipService.ToolTip="Add an outbound block rule for this IP">
                                    <TextBlock Text="Block IP"/>
                                </Button>
                            </StackPanel>
                            <ComboBox x:Name="RuleSortBox" Grid.Column="1" Width="130" SelectedIndex="0"
                                      SelectionChanged="OnRuleSortChanged">
                                <ComboBoxItem Content="Sort: Name" Tag="name"/>
                                <ComboBoxItem Content="Sort: Type" Tag="type"/>
                            </ComboBox>
                            <TextBox x:Name="RuleSearchBox" Grid.Column="2" PlaceholderText="Search rules…"
                                     Width="200" HorizontalAlignment="Right"
                                     TextChanged="OnRuleSearch"/>
                        </Grid>
                    </Border>

                    <!-- Column headers -->
                    <Border Grid.Row="1" Padding="14,8"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Rule Name" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Type" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="Direction" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="Action" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="Delete" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>

                    <!-- Rules list -->
                    <ListView x:Name="RulesList" Grid.Row="2" SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="14,8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="{Binding TypeBrush}" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RuleType}" FontSize="10" Foreground="White"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Direction}"
                                               FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Action}"
                                               FontSize="11" Foreground="{Binding ActionBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="4" Padding="6,4" FontSize="11"
                                            Click="OnDeleteRule" Tag="{Binding Name}">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Status bar -->
                    <Border Grid.Row="3" Padding="12,6"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RulesStatusBar" Text="Loading rules…"
                                       FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                            <!-- IMP#6: determinate progress + cancel for batch delete -->
                            <ProgressBar x:Name="RulesProgress" Grid.Column="1"
                                         Width="140" Height="4" Margin="8,0"
                                         Minimum="0" Maximum="100" Value="0"
                                         Visibility="Collapsed" VerticalAlignment="Center"/>
                            <Button x:Name="CancelBatchDelete" Grid.Column="2"
                                    Content="Cancel" FontSize="10" Padding="6,2"
                                    Click="OnCancelBatchDelete"
                                    Visibility="Collapsed"
                                    Style="{StaticResource TransparentButtonStyle}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
