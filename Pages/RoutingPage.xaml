<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WinNetControl.Pages.RoutingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border CornerRadius="10" Padding="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE838;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Routing Manager" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="IPv4/IPv6 routing table · Add / delete / change routes" FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ToggleButton x:Name="Ipv6Toggle" Content="IPv6" Padding="10,5"
                                  IsChecked="False" Checked="OnIpVersionChanged" Unchecked="OnIpVersionChanged"/>
                    <Button Padding="10,6" Click="OnRefreshRoutes">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                            <TextBlock Text="Refresh" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="12" Margin="16,14,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Add route form -->
            <StackPanel Grid.Column="0" Spacing="12">

                <Border CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Add Route" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox x:Name="DestBox"     Header="Destination Network" PlaceholderText="e.g. 10.0.0.0"/>
                        <TextBox x:Name="MaskBox"     Header="Subnet Mask / Prefix" PlaceholderText="e.g. 255.0.0.0 or /8"/>
                        <TextBox x:Name="GatewayBox"  Header="Gateway" PlaceholderText="e.g. 192.168.1.1"/>
                        <TextBox x:Name="MetricBox"   Header="Metric (optional)" PlaceholderText="1"/>
                        <TextBox x:Name="IfaceBox"    Header="Interface (optional)" PlaceholderText="adapter name or index"/>
                        <ToggleSwitch x:Name="PersistToggle" Header="Persistent (survives reboot)" IsOn="True"/>
                        <Button HorizontalAlignment="Stretch" Padding="10,8" Click="OnAddRoute"
                                Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="13"/>
                                <TextBlock Text="Add Route"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Delete selected -->
                <Border CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Delete Route" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                            Text="Select a route in the table, then delete it."/>
                        <Button HorizontalAlignment="Stretch" Padding="10,8" Click="OnDeleteSelected">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#E02020"/>
                                <TextBlock Text="Delete Selected Route"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Default gateway -->
                <Border CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Default Gateway" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox x:Name="GwBox" Header="New Gateway IP" PlaceholderText="e.g. 192.168.1.1"/>
                        <TextBox x:Name="GwIfaceBox" Header="Adapter Name" PlaceholderText="e.g. Ethernet"/>
                        <Button HorizontalAlignment="Stretch" Padding="10,8" Click="OnSetDefaultGw">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE838;" FontSize="13"/>
                                <TextBlock Text="Set Default Gateway"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="RouteStatus" Text="" FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Right: Route table -->
            <Border Grid.Column="1" CornerRadius="12" Padding="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search -->
                    <Border Grid.Row="0" Padding="14,10"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock x:Name="RouteCountText" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                            <TextBox x:Name="RouteSearch" PlaceholderText="Filter routes…"
                                     Width="200" HorizontalAlignment="Right"
                                     TextChanged="OnRouteSearch"/>
                        </Grid>
                    </Border>

                    <!-- Column headers -->
                    <Border Grid.Row="1" Padding="14,8"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Destination"    FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Subnet Mask"  FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="Gateway"      FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="Metric"       FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="Interface"    FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>

                    <ListView x:Name="RouteTable" Grid.Row="2" SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="14,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Destination}"
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Mask}"
                                               FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Gateway}"
                                               FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Metric}"
                                               FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Interface}"
                                               FontSize="11" Foreground="Gray" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
