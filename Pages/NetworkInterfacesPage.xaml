<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinNetControl.Pages.NetworkInterfacesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border CornerRadius="10" Padding="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE839;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Network Interfaces" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Enable · Disable · MTU · MAC · DHCP / Static IP" FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Padding="12,6" Click="OnRefreshAdapters" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                        <TextBlock Text="Refresh" FontSize="12"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="12" Margin="16,14,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: Adapter list ── -->
            <Border Grid.Column="0" CornerRadius="12" Padding="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14,10"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Adapters" FontSize="13" FontWeight="SemiBold"/>
                    </Border>

                    <ListView x:Name="AdapterListView" Grid.Row="1"
                              SelectionMode="Single"
                              SelectionChanged="OnAdapterSelected">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="14,10"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{Binding TypeGlyph}" FontSize="20"
                                              Foreground="{Binding StatusBrush}"
                                              VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="10"
                                                   Foreground="{Binding StatusBrush}"/>
                                    </StackPanel>
                                    <Ellipse Grid.Column="2" Width="8" Height="8"
                                             Fill="{Binding StatusDotBrush}"
                                             VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- ── Right: Adapter details + controls ── -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DetailPanel" Spacing="12">

                    <!-- Enable / Disable / Restart quick actions -->
                    <Border CornerRadius="12" Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="AdapterNameText" Text="Select an adapter"
                                       FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AdapterDescText" Text="" FontSize="12" Foreground="Gray"/>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <Button x:Name="EnableBtn" Padding="12,6" Click="OnEnable"
                                        Style="{ThemeResource AccentButtonStyle}" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE73E;" FontSize="13"/>
                                        <TextBlock Text="Enable"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DisableBtn" Padding="12,6" Click="OnDisable" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE711;" FontSize="13"/>
                                        <TextBlock Text="Disable"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RestartBtn" Padding="12,6" Click="OnRestart" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE777;" FontSize="13"/>
                                        <TextBlock Text="Restart"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <TextBlock x:Name="ActionStatus" Text="" FontSize="11" Foreground="Gray"/>
                        </StackPanel>
                    </Border>

                    <!-- Info grid -->
                    <Border CornerRadius="12" Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Interface Details" FontSize="13" FontWeight="SemiBold"/>
                            <Grid ColumnSpacing="16" RowSpacing="8" x:Name="InfoGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="IPv4" Foreground="Gray" FontSize="11"/>
                                <TextBlock x:Name="InfoIPv4" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Text="—" IsTextSelectionEnabled="True"/>
                                <TextBlock Grid.Column="2" Text="Subnet" Foreground="Gray" FontSize="11"/>
                                <TextBlock x:Name="InfoSubnet" Grid.Column="3" FontSize="11" Text="—" IsTextSelectionEnabled="True"/>

                                <TextBlock Grid.Row="1" Text="IPv6" Foreground="Gray" FontSize="11"/>
                                <TextBlock x:Name="InfoIPv6" Grid.Row="1" Grid.Column="1" FontSize="11" Text="—" IsTextSelectionEnabled="True"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Gateway" Foreground="Gray" FontSize="11"/>
                                <TextBlock x:Name="InfoGateway" Grid.Row="1" Grid.Column="3" FontSize="11" Text="—" IsTextSelectionEnabled="True"/>

                                <TextBlock Grid.Row="2" Text="MAC Address" Foreground="Gray" FontSize="11"/>
                                <TextBlock x:Name="InfoMac" Grid.Row="2" Grid.Column="1" FontSize="11" FontFamily="Consolas" Text="—" IsTextSelectionEnabled="True"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="MTU" Foreground="Gray" FontSize="11"/>
                                <TextBlock x:Name="InfoMtu" Grid.Row="2" Grid.Column="3" FontSize="11" Text="—"/>

                                <TextBlock Grid.Row="3" Text="DNS" Foreground="Gray" FontSize="11"/>
                                <TextBlock x:Name="InfoDns" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" FontSize="11" Text="—" IsTextSelectionEnabled="True"/>

                                <TextBlock Grid.Row="4" Text="Speed" Foreground="Gray" FontSize="11"/>
                                <TextBlock x:Name="InfoSpeed" Grid.Row="4" Grid.Column="1" FontSize="11" Text="—"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="Type" Foreground="Gray" FontSize="11"/>
                                <TextBlock x:Name="InfoType" Grid.Row="4" Grid.Column="3" FontSize="11" Text="—"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- DHCP / Static IP toggle -->
                    <Border CornerRadius="12" Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <Grid>
                                <TextBlock Text="IP Configuration" FontSize="13" FontWeight="SemiBold"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <RadioButton x:Name="DhcpRadio" Content="DHCP (Auto)"
                                                 GroupName="IpMode" IsChecked="True"
                                                 Checked="OnIpModeChanged"/>
                                    <RadioButton x:Name="StaticRadio" Content="Static"
                                                 GroupName="IpMode"
                                                 Checked="OnIpModeChanged"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="StaticIpPanel" Spacing="10" Visibility="Collapsed">
                                <Grid ColumnSpacing="10" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBox x:Name="StaticIpBox" Header="IP Address"
                                             PlaceholderText="192.168.1.100"/>
                                    <TextBox x:Name="StaticMaskBox" Grid.Column="1" Header="Subnet Mask"
                                             PlaceholderText="255.255.255.0"/>
                                    <TextBox x:Name="StaticGwBox" Grid.Row="1" Header="Default Gateway"
                                             PlaceholderText="192.168.1.1"/>
                                    <TextBox x:Name="StaticDns1Box" Grid.Row="1" Grid.Column="1" Header="Primary DNS"
                                             PlaceholderText="8.8.8.8"/>
                                    <TextBox x:Name="StaticDns2Box" Grid.Row="2" Header="Secondary DNS"
                                             PlaceholderText="8.8.4.4"/>
                                </Grid>

                                <Button Padding="12,6" Click="OnApplyStaticIp"
                                        Style="{ThemeResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE73E;" FontSize="13"/>
                                        <TextBlock Text="Apply Static IP"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Button x:Name="RenewDhcpBtn" Padding="12,6" Click="OnRenewDhcp" IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                                    <TextBlock Text="Renew DHCP Lease"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- MTU editor -->
                    <Border CornerRadius="12" Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="MTU Settings" FontSize="13" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <NumberBox x:Name="MtuBox" Header="MTU Value" Value="1500"
                                           Minimum="576" Maximum="9000" SpinButtonPlacementMode="Inline"
                                           Width="200"/>
                                <StackPanel Spacing="6" VerticalAlignment="Bottom">
                                    <Button Padding="10,6" Click="OnSetMtu" IsEnabled="False" x:Name="SetMtuBtn">
                                        <TextBlock Text="Apply"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Padding="8,4" FontSize="11" Click="OnMtuPreset" Tag="1500">
                                    <TextBlock Text="1500 (Default)"/>
                                </Button>
                                <Button Padding="8,4" FontSize="11" Click="OnMtuPreset" Tag="1492">
                                    <TextBlock Text="1492 (PPPoE)"/>
                                </Button>
                                <Button Padding="8,4" FontSize="11" Click="OnMtuPreset" Tag="1472">
                                    <TextBlock Text="1472 (VPN)"/>
                                </Button>
                                <Button Padding="8,4" FontSize="11" Click="OnMtuPreset" Tag="9000">
                                    <TextBlock Text="9000 (Jumbo)"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- DNS flush / quick actions -->
                    <Border CornerRadius="12" Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Quick Actions" FontSize="13" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" FlowDirection="LeftToRight">
                                <Button Padding="10,6" Click="OnFlushDns">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                                        <TextBlock Text="Flush DNS"/>
                                    </StackPanel>
                                </Button>
                                <Button Padding="10,6" Click="OnReleaseRenew">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                                        <TextBlock Text="Release + Renew"/>
                                    </StackPanel>
                                </Button>
                                <Button Padding="10,6" Click="OnResetWinsock">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE777;" FontSize="13"/>
                                        <TextBlock Text="Reset Winsock"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="QuickActionStatus" Text="" FontSize="11" Foreground="Gray"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
