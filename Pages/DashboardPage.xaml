<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinNetControl.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- Converters resolved from App.xaml global resources -->


    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="20,16,20,24">

            <!-- ═══ Page header ═══ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold"/>
                    <TextBlock x:Name="SubtitleText"
                               Text="Network overview — updated every second"
                               FontSize="12" Foreground="Gray"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Internet quality score badge -->
                    <Border x:Name="QualityBadge" CornerRadius="20" Padding="14,6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE879;" FontSize="14"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <StackPanel>
                                <TextBlock Text="Quality Score" FontSize="10" Foreground="Gray"/>
                                <TextBlock x:Name="QualityScore" Text="—" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button Padding="10,6" Click="OnRefreshClicked" ToolTipService.ToolTip="Refresh">
                        <FontIcon Glyph="&#xE72C;" FontSize="15"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══ HERO — Live Speed Cards Row ═══ -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Upload Speed -->
                <Border Grid.Column="0" CornerRadius="12" Padding="16,14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border CornerRadius="8" Padding="6" Background="#1A0078D4">
                                <FontIcon Glyph="&#xE898;" FontSize="16" Foreground="#0078D4"/>
                            </Border>
                            <TextBlock Text="Upload" VerticalAlignment="Center" FontSize="12" Foreground="Gray"/>
                        </StackPanel>
                        <TextBlock x:Name="CardUpload" Text="0 B/s" FontSize="22" FontWeight="Bold" Foreground="#0078D4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CardUploadPeak" Text="Peak: 0 B/s" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>
                            <!-- IMP#2: Reset Peaks button -->
                            <Button Grid.Column="1" Content="Reset" Click="OnResetPeaks"
                                    FontSize="9" Padding="6,2" Margin="4,0,0,0"
                                    Style="{StaticResource TransparentButtonStyle}"
                                    ToolTipService.ToolTip="Reset upload and download peak values"/>
                        </Grid>
                        <!-- Mini sparkline bar -->
                        <ProgressBar x:Name="UploadBar" Maximum="100" Value="0" Height="4" CornerRadius="2"
                                     Foreground="#0078D4" Background="#1A0078D4"/>
                    </StackPanel>
                </Border>

                <!-- Download Speed -->
                <Border Grid.Column="1" CornerRadius="12" Padding="16,14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border CornerRadius="8" Padding="6" Background="#1A107C10">
                                <FontIcon Glyph="&#xE896;" FontSize="16" Foreground="#107C10"/>
                            </Border>
                            <TextBlock Text="Download" VerticalAlignment="Center" FontSize="12" Foreground="Gray"/>
                        </StackPanel>
                        <TextBlock x:Name="CardDownload" Text="0 B/s" FontSize="22" FontWeight="Bold" Foreground="#107C10"/>
                        <TextBlock x:Name="CardDownloadPeak" Text="Peak: 0 B/s" FontSize="10" Foreground="Gray"/>
                        <ProgressBar x:Name="DownloadBar" Maximum="100" Value="0" Height="4" CornerRadius="2"
                                     Foreground="#107C10" Background="#1A107C10"/>
                    </StackPanel>
                </Border>

                <!-- Blocked Apps -->
                <Border Grid.Column="2" CornerRadius="12" Padding="16,14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border CornerRadius="8" Padding="6" Background="#1AE02020">
                                <FontIcon Glyph="&#xF140;" FontSize="16" Foreground="#E02020"/>
                            </Border>
                            <TextBlock Text="Blocked" VerticalAlignment="Center" FontSize="12" Foreground="Gray"/>
                        </StackPanel>
                        <TextBlock x:Name="CardBlocked" Text="0 apps" FontSize="22" FontWeight="Bold"/>
                        <TextBlock x:Name="CardBlockedSub" Text="0 connections blocked" FontSize="10" Foreground="Gray"/>
                        <ProgressBar x:Name="BlockedBar" Maximum="100" Value="0" Height="4" CornerRadius="2"
                                     Foreground="#E02020" Background="#1AE02020"/>
                    </StackPanel>
                </Border>

                <!-- Active Connections -->
                <Border Grid.Column="3" CornerRadius="12" Padding="16,14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border CornerRadius="8" Padding="6" Background="#1A8764">
                                <FontIcon Glyph="&#xE9CE;" FontSize="16" Foreground="#107C10"/>
                            </Border>
                            <TextBlock Text="Active Apps" VerticalAlignment="Center" FontSize="12" Foreground="Gray"/>
                        </StackPanel>
                        <TextBlock x:Name="CardApps" Text="0" FontSize="22" FontWeight="Bold"/>
                        <TextBlock x:Name="CardAppsSub" Text="monitoring" FontSize="10" Foreground="Gray"/>
                        <ProgressBar x:Name="AppsBar" Maximum="100" Value="0" Height="4" CornerRadius="2"
                                     Foreground="#107C10" Background="#1A107C10"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ Second Row — Network Info + Ping Graph + Session ═══ -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Network Info Card -->
                <Border Grid.Column="0" CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Network Info" FontSize="13" FontWeight="SemiBold"/>

                        <!-- Info rows -->
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="IPv4" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="InfoIPv4" Grid.Column="1" FontSize="11" FontWeight="SemiBold"
                                       Text="—" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="2" Click="OnCopyIPv4" VerticalAlignment="Center"
                                    Style="{StaticResource TransparentButtonStyle}" Padding="4" Margin="2,0,0,0"
                                    ToolTipService.ToolTip="Copy IPv4 address">
                                <FontIcon Glyph="&#xE8C8;" FontSize="10"/>
                            </Button>

                            <TextBlock Grid.Row="1" Text="Public IP" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="InfoPublicIP" Grid.Row="1" Grid.Column="1" FontSize="11" FontWeight="SemiBold"
                                       Text="—" VerticalAlignment="Center"/>
                            <Button Grid.Row="1" Grid.Column="2" Click="OnCopyPublicIP" VerticalAlignment="Center"
                                    Style="{StaticResource TransparentButtonStyle}" Padding="4" Margin="2,0,0,0"
                                    ToolTipService.ToolTip="Copy Public IP">
                                <FontIcon Glyph="&#xE8C8;" FontSize="10"/>
                            </Button>

                            <TextBlock Grid.Row="2" Text="Gateway" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="InfoGateway" Grid.Row="2" Grid.Column="1" FontSize="11"
                                       Text="—" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Row="2" Grid.Column="2" Click="OnCopyGateway" VerticalAlignment="Center"
                                    Style="{StaticResource TransparentButtonStyle}" Padding="4" Margin="2,0,0,0"
                                    ToolTipService.ToolTip="Copy Gateway">
                                <FontIcon Glyph="&#xE8C8;" FontSize="10"/>
                            </Button>

                            <TextBlock Grid.Row="3" Text="DNS" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="InfoDns" Grid.Row="3" Grid.Column="1" FontSize="11"
                                       Text="—" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Row="3" Grid.Column="2" Click="OnCopyDns" VerticalAlignment="Center"
                                    Style="{StaticResource TransparentButtonStyle}" Padding="4" Margin="2,0,0,0"
                                    ToolTipService.ToolTip="Copy DNS">
                                <FontIcon Glyph="&#xE8C8;" FontSize="10"/>
                            </Button>

                            <TextBlock Grid.Row="4" Text="Adapter" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="InfoAdapter" Grid.Row="4" Grid.Column="1" FontSize="11"
                                       Text="—" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                            <TextBlock Grid.Row="5" Text="MAC" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="InfoMac" Grid.Row="5" Grid.Column="1" FontSize="11" FontFamily="Consolas"
                                       Text="—" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Row="5" Grid.Column="2" Click="OnCopyMac" VerticalAlignment="Center"
                                    Style="{StaticResource TransparentButtonStyle}" Padding="4" Margin="2,0,0,0"
                                    ToolTipService.ToolTip="Copy MAC address">
                                <FontIcon Glyph="&#xE8C8;" FontSize="10"/>
                            </Button>

                            <TextBlock Grid.Row="6" Text="IPv6" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="InfoIPv6" Grid.Row="6" Grid.Column="1" FontSize="11"
                                       Text="—" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Row="6" Grid.Column="2" Click="OnCopyIPv6" VerticalAlignment="Center"
                                    Style="{StaticResource TransparentButtonStyle}" Padding="4" Margin="2,0,0,0"
                                    ToolTipService.ToolTip="Copy IPv6 address">
                                <FontIcon Glyph="&#xE8C8;" FontSize="10"/>
                            </Button>

                            <TextBlock Grid.Row="7" Text="ISP" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="InfoISP" Grid.Row="7" Grid.Column="1" FontSize="11"
                                       Text="—" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Ping / Latency Graph Card -->
                <Border Grid.Column="1" CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Latency Monitor" FontSize="13" FontWeight="SemiBold"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <StackPanel>
                                    <TextBlock Text="Ping" FontSize="9" Foreground="Gray" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="PingMs" Text="—" FontSize="16" FontWeight="Bold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </StackPanel>
                                <Rectangle Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Stretch"/>
                                <StackPanel>
                                    <TextBlock Text="Jitter" FontSize="9" Foreground="Gray" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="JitterMs" Text="—" FontSize="16" FontWeight="Bold" Foreground="#FBBC05"/>
                                </StackPanel>
                                <Rectangle Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Stretch"/>
                                <StackPanel>
                                    <TextBlock Text="Loss" FontSize="9" Foreground="Gray" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="PacketLoss" Text="—" FontSize="16" FontWeight="Bold" Foreground="#E02020"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Ping waveform (canvas placeholder — filled from code-behind) -->
                        <Border CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <Canvas x:Name="PingCanvas" Height="110"/>
                        </Border>

                        <!-- Target host row -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="PingTarget" Text="8.8.8.8" Width="130" Height="30"
                                     PlaceholderText="Ping target"/>
                            <Button Padding="8,5" Click="OnPingStartStop" x:Name="PingBtn">
                                <TextBlock x:Name="PingBtnText" Text="Start"/>
                            </Button>
                            <TextBlock x:Name="PingStatusText" VerticalAlignment="Center"
                                       FontSize="11" Foreground="Gray"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Session + Uptime Card -->
                <Border Grid.Column="2" CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Session Stats" FontSize="13" FontWeight="SemiBold"/>

                        <StackPanel Spacing="8">
                            <!-- Session duration -->
                            <Border CornerRadius="8" Padding="12,10"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Uptime" FontSize="10" Foreground="Gray"/>
                                    <TextBlock x:Name="SessionUptime" Text="00:00:00"
                                               FontSize="20" FontWeight="Bold" FontFamily="Consolas"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Session total data -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="8" Padding="10,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="↑ Sent" FontSize="10" Foreground="#0078D4"/>
                                        <TextBlock x:Name="TotalSent" Text="0 B" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" CornerRadius="8" Padding="10,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="↓ Received" FontSize="10" Foreground="#107C10"/>
                                        <TextBlock x:Name="TotalRecv" Text="0 B" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Wi-Fi signal -->
                            <Border CornerRadius="8" Padding="10,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Wi-Fi Signal" FontSize="10" Foreground="Gray"/>
                                        <TextBlock x:Name="WifiSignal" Text="N/A" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <FontIcon Grid.Column="1" x:Name="WifiIcon" Glyph="&#xEC3B;"
                                              FontSize="22" VerticalAlignment="Center"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </Grid>
                            </Border>

                            <!-- Connection uptime -->
                            <Border CornerRadius="8" Padding="10,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Connection Uptime" FontSize="10" Foreground="Gray"/>
                                    <TextBlock x:Name="ConnUptime" Text="—" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ Third Row — Quick Launch Modules ═══ -->
            <Border CornerRadius="12" Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Quick Launch" FontSize="13" FontWeight="SemiBold"/>
                    <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" HorizontalAlignment="Stretch" Padding="8,10"
                                Click="OnQuickNav" Tag="Connections">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE9CE;" FontSize="20"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Connections" FontSize="10" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" HorizontalAlignment="Stretch" Padding="8,10"
                                Click="OnQuickNav" Tag="Firewall">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE7BA;" FontSize="20" Foreground="#E02020"/>
                                <TextBlock Text="Firewall" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" HorizontalAlignment="Stretch" Padding="8,10"
                                Click="OnQuickNav" Tag="Dns">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE771;" FontSize="20" Foreground="#FBBC05"/>
                                <TextBlock Text="DNS" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" HorizontalAlignment="Stretch" Padding="8,10"
                                Click="OnQuickNav" Tag="Diagnostics">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE879;" FontSize="20" Foreground="#0078D4"/>
                                <TextBlock Text="Diagnostics" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="4" HorizontalAlignment="Stretch" Padding="8,10"
                                Click="OnQuickNav" Tag="Wireless">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xEC3B;" FontSize="20" Foreground="#107C10"/>
                                <TextBlock Text="Wi-Fi" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="5" HorizontalAlignment="Stretch" Padding="8,10"
                                Click="OnQuickNav" Tag="Monitoring">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE9D9;" FontSize="20" Foreground="#8764B8"/>
                                <TextBlock Text="Monitoring" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="6" HorizontalAlignment="Stretch" Padding="8,10"
                                Click="OnQuickNav" Tag="Speed">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xEC4A;" FontSize="20" Foreground="#00B7C3"/>
                                <TextBlock Text="Speed Test" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ Fourth Row — Top Apps Table + Recent Alerts ═══ -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Top Apps by bandwidth -->
                <Border Grid.Column="0" CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="Top Apps" FontSize="13" FontWeight="SemiBold"/>
                            <Button HorizontalAlignment="Right" Padding="6,3" Click="OnViewAllApps" FontSize="11">
                                <TextBlock Text="View All →"/>
                            </Button>
                        </Grid>
                        <ListView x:Name="TopAppsList" SelectionMode="None" MaxHeight="280">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0,4"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ProcessName}"
                                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding UploadSpeed, Converter={StaticResource SpeedConverter}}"
                                                   FontSize="11" Foreground="#0078D4" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DownloadSpeed, Converter={StaticResource SpeedConverter}}"
                                                   FontSize="11" Foreground="#107C10" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding TotalDataUsed, Converter={StaticResource SizeConverter}}"
                                                   FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Recent activity / health panel -->
                <Border Grid.Column="1" CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Health &amp; Alerts" FontSize="13" FontWeight="SemiBold"/>

                        <!-- Internet status -->
                        <Border CornerRadius="8" Padding="12"
                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Internet Status" FontSize="10" Foreground="Gray"/>
                                    <TextBlock x:Name="InternetStatus" Text="Checking…"
                                               FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                                <Ellipse Grid.Column="1" x:Name="StatusDot"
                                         Width="12" Height="12" VerticalAlignment="Center"
                                         Fill="Gray"/>
                            </Grid>
                        </Border>

                        <!-- Health items -->
                        <StackPanel x:Name="HealthList" Spacing="6"/>

                        <!-- Recent alert log -->
                        <TextBlock Text="Recent Events" FontSize="11" FontWeight="SemiBold" Foreground="Gray"/>
                        <ListView x:Name="AlertsList" SelectionMode="None" MaxHeight="160">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0,2"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="6" Height="6" Fill="{Binding Color}"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Message}"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
