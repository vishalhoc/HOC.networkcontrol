<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinNetControl.Pages.TerminalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border CornerRadius="10" Padding="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE756;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Terminal" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Built-in shell — CMD · PowerShell · Network commands" FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <RadioButton x:Name="ShellCmd" Content="CMD" GroupName="Shell"
                                 IsChecked="True" Checked="OnShellChanged"/>
                    <RadioButton x:Name="ShellPs"  Content="PowerShell" GroupName="Shell"
                                 Checked="OnShellChanged"/>
                    <Button Padding="10,6" Click="OnClearTerminal">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                            <TextBlock Text="Clear" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Padding="10,6" Click="OnCopyOutput">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8C8;" FontSize="13"/>
                            <TextBlock Text="Copy" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Terminal body -->
        <Grid Grid.Row="1" RowSpacing="0" Margin="16,14,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Quick command chips -->
            <Border Grid.Row="0" CornerRadius="10" Padding="12,8" Margin="0,0,0,8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Quick:" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                        <Button Padding="8,4" FontSize="11" Click="OnQuickCmd" Tag="ipconfig /all">
                            <TextBlock Text="ipconfig /all"/>
                        </Button>
                        <Button Padding="8,4" FontSize="11" Click="OnQuickCmd" Tag="netstat -an">
                            <TextBlock Text="netstat -an"/>
                        </Button>
                        <Button Padding="8,4" FontSize="11" Click="OnQuickCmd" Tag="arp -a">
                            <TextBlock Text="arp -a"/>
                        </Button>
                        <Button Padding="8,4" FontSize="11" Click="OnQuickCmd" Tag="route print">
                            <TextBlock Text="route print"/>
                        </Button>
                        <Button Padding="8,4" FontSize="11" Click="OnQuickCmd" Tag="nslookup google.com">
                            <TextBlock Text="nslookup"/>
                        </Button>
                        <Button Padding="8,4" FontSize="11" Click="OnQuickCmd" Tag="ping 8.8.8.8 -n 5">
                            <TextBlock Text="ping 8.8.8.8"/>
                        </Button>
                        <Button Padding="8,4" FontSize="11" Click="OnQuickCmd" Tag="tracert 8.8.8.8">
                            <TextBlock Text="tracert"/>
                        </Button>
                        <Button Padding="8,4" FontSize="11" Click="OnQuickCmd" Tag="netsh wlan show all">
                            <TextBlock Text="wlan info"/>
                        </Button>
                        <Button Padding="8,4" FontSize="11" Click="OnQuickCmd" Tag="netsh int ip show config">
                            <TextBlock Text="ip config"/>
                        </Button>
                        <Button Padding="8,4" FontSize="11" Click="OnQuickCmd" Tag="systeminfo | findstr /i &quot;network&quot;">
                            <TextBlock Text="systeminfo"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Output area -->
            <Border Grid.Row="1" CornerRadius="10"
                    Background="#0C000000"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <ScrollViewer x:Name="OutputScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <TextBlock x:Name="OutputText"
                               FontFamily="Cascadia Code, Consolas, Courier New"
                               FontSize="12.5" TextWrapping="NoWrap"
                               IsTextSelectionEnabled="True"
                               Padding="14,12"
                               Text="Windows Network Control — Built-in Terminal&#x0A;Type a command and press Enter, or click a quick command above.&#x0A;"/>
                </ScrollViewer>
            </Border>

            <!-- Input row -->
            <Border Grid.Row="2" Margin="0,8,0,0" CornerRadius="10" Padding="10,8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PromptLabel" Text="C:\&gt;" FontSize="13"
                               FontFamily="Cascadia Code, Consolas"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="InputBox" Grid.Column="1"
                             FontFamily="Cascadia Code, Consolas" FontSize="13"
                             BorderThickness="0" Background="Transparent"
                             PlaceholderText="Enter command…"
                             KeyDown="OnInputKeyDown"
                             VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Padding="14,6" Click="OnRunCommand"
                            Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="RunIcon" Glyph="&#xE768;" FontSize="13"/>
                            <TextBlock x:Name="RunBtnText" Text="Run"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
