<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinNetControl.Pages.QosManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border CornerRadius="10" Padding="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE9F3;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="QoS Manager" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Quality of Service · Traffic shaping · Policy-based QoS (user-space)" FontSize="12" Foreground="Gray"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14" Padding="16,14,16,24">

                <!-- Info banner -->
                <Border CornerRadius="12" Padding="16"
                        Background="#1A0078D4"
                        BorderBrush="#400078D4" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE946;" FontSize="22" Foreground="#0078D4" VerticalAlignment="Top"/>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Policy-based QoS (User-space)" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="Gray"
                                Text="Windows QoS policies are managed via Group Policy / netsh. This page lets you create, list and remove QoS policies using the built-in Windows QoS subsystem. Policies take effect immediately for matching applications or DSCP-tagged traffic."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Current policies -->
                <Border CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="Active QoS Policies" FontSize="13" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Padding="8,5" Click="OnRefreshPolicies">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                                        <TextBlock Text="Refresh" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ScrollViewer Height="180" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="PolicyOutput"
                                       FontFamily="Cascadia Code, Consolas" FontSize="12"
                                       IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                       Text="Click Refresh to load current QoS policies…"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Create new policy -->
                <Border CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Create QoS Policy" FontSize="13" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBox x:Name="PolicyName" Header="Policy Name"
                                     PlaceholderText="e.g. GamePriority"/>
                            <TextBox x:Name="PolicyApp" Grid.Column="1" Header="Application (optional)"
                                     PlaceholderText="e.g. game.exe"/>

                            <ComboBox x:Name="PriorityCombo" Grid.Row="1" Header="DSCP Priority"
                                      HorizontalAlignment="Stretch" SelectedIndex="2">
                                <ComboBoxItem Content="0 — Best Effort (default)" Tag="0"/>
                                <ComboBoxItem Content="8 — Background" Tag="8"/>
                                <ComboBoxItem Content="16 — Standard" Tag="16"/>
                                <ComboBoxItem Content="24 — Video" Tag="24"/>
                                <ComboBoxItem Content="32 — Interactive" Tag="32"/>
                                <ComboBoxItem Content="40 — Streaming" Tag="40"/>
                                <ComboBoxItem Content="46 — Expedited (VoIP/Gaming)" Tag="46"/>
                                <ComboBoxItem Content="48 — Network Control" Tag="48"/>
                            </ComboBox>
                            <NumberBox x:Name="ThrottleKbps" Grid.Row="1" Grid.Column="1"
                                       Header="Throttle Rate (Kbps, 0=unlimited)"
                                       Value="0" Minimum="0" Maximum="1000000"
                                       SpinButtonPlacementMode="Inline"/>

                            <TextBox x:Name="PolicyDestIp" Grid.Row="2" Header="Destination IP (optional)"
                                     PlaceholderText="e.g. 192.168.1.0/24"/>
                            <NumberBox x:Name="PolicyPort" Grid.Row="2" Grid.Column="1"
                                       Header="Destination Port (0=any)"
                                       Value="0" Minimum="0" Maximum="65535"
                                       SpinButtonPlacementMode="Inline"/>
                        </Grid>

                        <Button Padding="14,8" Click="OnCreatePolicy"
                                Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="13"/>
                                <TextBlock Text="Create Policy"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="PolicyStatus" Text="" FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Remove policy -->
                <Border CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Remove Policy" FontSize="13" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBox x:Name="RemovePolicyName" PlaceholderText="Policy name to remove"
                                     Width="260"/>
                            <Button Padding="12,6" Click="OnRemovePolicy">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#E02020"/>
                                    <TextBlock Text="Remove"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Preset policies -->
                <Border CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="One-Click Presets" FontSize="13" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" FlowDirection="LeftToRight">
                            <Button Padding="12,8" Click="OnPreset" Tag="gaming">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE7FC;" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Gaming Priority" FontSize="11" HorizontalAlignment="Center"/>
                                    <TextBlock Text="DSCP 46" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Padding="12,8" Click="OnPreset" Tag="video">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B2;" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Video Streaming" FontSize="11" HorizontalAlignment="Center"/>
                                    <TextBlock Text="DSCP 40" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Padding="12,8" Click="OnPreset" Tag="voip">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE717;" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="VoIP Priority" FontSize="11" HorizontalAlignment="Center"/>
                                    <TextBlock Text="DSCP 46" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Padding="12,8" Click="OnPreset" Tag="background">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE895;" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Background Low" FontSize="11" HorizontalAlignment="Center"/>
                                    <TextBlock Text="DSCP 8" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
