<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinNetControl.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border CornerRadius="10" Padding="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE879;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Diagnostics" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Ping · Traceroute · NSLookup · Whois · DNS Benchmark" FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="ClearOutputBtn" Padding="10,6" Click="OnClearOutput">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                            <TextBlock Text="Clear" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CopyOutputBtn" Padding="10,6" Click="OnCopyOutput">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8C8;" FontSize="13"/>
                            <TextBlock Text="Copy" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" ColumnSpacing="12" Margin="16,14,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left panel: Tool selector + params ── -->
            <StackPanel Grid.Column="0" Spacing="10">

                <!-- Target host input -->
                <Border CornerRadius="10" Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Target" FontSize="12" FontWeight="SemiBold"/>
                        <TextBox x:Name="TargetHost" PlaceholderText="hostname or IP" Text="8.8.8.8"
                                 HorizontalAlignment="Stretch"/>
                        <!-- Quick presets -->
                        <StackPanel Orientation="Horizontal" Spacing="6" FlowDirection="LeftToRight">
                            <Button Padding="6,4" FontSize="11" Click="OnPreset" Tag="8.8.8.8">
                                <TextBlock Text="Google DNS"/>
                            </Button>
                            <Button Padding="6,4" FontSize="11" Click="OnPreset" Tag="1.1.1.1">
                                <TextBlock Text="Cloudflare"/>
                            </Button>
                            <Button Padding="6,4" FontSize="11" Click="OnPreset" Tag="google.com">
                                <TextBlock Text="Google"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Tool cards -->
                <TextBlock Text="Tools" FontSize="12" FontWeight="SemiBold" Foreground="Gray" Margin="0,4,0,0"/>

                <!-- Ping -->
                <Border CornerRadius="10" Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE879;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Ping" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Count" FontSize="11" Foreground="Gray"/>
                                <NumberBox x:Name="PingCount" Value="4" Minimum="1" Maximum="100" SpinButtonPlacementMode="Inline"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Timeout (ms)" FontSize="11" Foreground="Gray"/>
                                <NumberBox x:Name="PingTimeout" Value="1000" Minimum="100" Maximum="10000" SpinButtonPlacementMode="Inline"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="PingContinuous" Content="Continuous ping" FontSize="12"/>
                        <Button x:Name="PingBtn" HorizontalAlignment="Stretch" Click="OnRunPing"
                                Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="13"/>
                                <TextBlock x:Name="PingBtnText" Text="Run Ping"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Traceroute -->
                <Border CornerRadius="10" Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE909;" FontSize="16" Foreground="#FBBC05"/>
                            <TextBlock Text="Traceroute" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Max Hops" FontSize="11" Foreground="Gray"/>
                            <NumberBox x:Name="TraceHops" Value="30" Minimum="5" Maximum="64" SpinButtonPlacementMode="Inline"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Stretch" Click="OnRunTrace">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="13"/>
                                <TextBlock Text="Run Traceroute"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- NSLookup -->
                <Border CornerRadius="10" Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE771;" FontSize="16" Foreground="#107C10"/>
                            <TextBlock Text="NSLookup / DNS" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ComboBox x:Name="DnsRecordType" Header="Record Type" HorizontalAlignment="Stretch" SelectedIndex="0">
                            <ComboBoxItem Content="A (IPv4)"/>
                            <ComboBoxItem Content="AAAA (IPv6)"/>
                            <ComboBoxItem Content="MX (Mail)"/>
                            <ComboBoxItem Content="NS (Name Server)"/>
                            <ComboBoxItem Content="TXT"/>
                            <ComboBoxItem Content="CNAME"/>
                            <ComboBoxItem Content="SOA"/>
                            <ComboBoxItem Content="PTR (Reverse)"/>
                        </ComboBox>
                        <TextBox x:Name="CustomDnsServer" PlaceholderText="Custom DNS (optional)" Header="DNS Server"/>
                        <Button HorizontalAlignment="Stretch" Click="OnRunNslookup">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="13"/>
                                <TextBlock Text="Lookup"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Whois / Port Check -->
                <Border CornerRadius="10" Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8C4;" FontSize="16" Foreground="#E02020"/>
                            <TextBlock Text="Port Check" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <NumberBox x:Name="PortNumber" Header="Port" Value="80" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Inline"/>
                        <Button HorizontalAlignment="Stretch" Click="OnRunPortCheck">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="13"/>
                                <TextBlock Text="Check Port"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ── Right panel: Output terminal ── -->
            <Grid Grid.Column="1" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Live stats bar -->
                <Grid Grid.Row="0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="8" Padding="12,8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Min" FontSize="10" Foreground="Gray"/>
                            <TextBlock x:Name="StatMin" Text="—" FontSize="14" FontWeight="Bold" Foreground="#107C10"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" CornerRadius="8" Padding="12,8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Max" FontSize="10" Foreground="Gray"/>
                            <TextBlock x:Name="StatMax" Text="—" FontSize="14" FontWeight="Bold" Foreground="#E02020"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" CornerRadius="8" Padding="12,8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Avg" FontSize="10" Foreground="Gray"/>
                            <TextBlock x:Name="StatAvg" Text="—" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" CornerRadius="8" Padding="12,8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Loss" FontSize="10" Foreground="Gray"/>
                            <TextBlock x:Name="StatLoss" Text="—" FontSize="14" FontWeight="Bold" Foreground="#FBBC05"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Output terminal -->
                <Border Grid.Row="1" CornerRadius="10"
                        Background="#0D000000"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <ScrollViewer x:Name="OutputScroller" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <TextBlock x:Name="OutputText"
                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="12.5"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   Padding="16,14"
                                   Text="Ready. Select a tool and click Run."/>
                    </ScrollViewer>
                </Border>

                <!-- Status bar -->
                <Border Grid.Row="2" CornerRadius="8" Padding="12,6"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Text="Idle" FontSize="11" VerticalAlignment="Center" Foreground="Gray"/>
                        <ProgressBar x:Name="RunProgress" Grid.Column="1" Width="120" Height="4"
                                     IsIndeterminate="False" Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
