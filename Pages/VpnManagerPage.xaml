<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WinNetControl.Pages.VpnManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border CornerRadius="10" Padding="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE753;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="VPN Manager" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="VPN connections · Adapters · rasdial · Windows VPN profiles" FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Padding="10,6" Click="OnRefresh" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                        <TextBlock Text="Refresh" FontSize="12"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="12" Margin="16,14,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel -->
            <StackPanel Spacing="12">

                <!-- Active VPN status -->
                <Border CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Active VPN Connection" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VpnStatusText" Text="Checking…" FontSize="12" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Padding="10,7" Click="OnDisconnectAll">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="#E02020"/>
                                    <TextBlock Text="Disconnect All" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Padding="10,7" Click="OnOpenVpnSettings">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE713;" FontSize="13"/>
                                    <TextBlock Text="VPN Settings" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Connect to profile -->
                <Border CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Connect to Profile" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox x:Name="VpnProfileName" Header="Profile Name"
                                 PlaceholderText="e.g. MyVPN (from Windows VPN list)"/>
                        <TextBox x:Name="VpnUsername" Header="Username (optional)"/>
                        <PasswordBox x:Name="VpnPassword" Header="Password (optional)"/>
                        <Button HorizontalAlignment="Stretch" Padding="10,8" Click="OnConnect"
                                Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE753;" FontSize="13"/>
                                <TextBlock Text="Connect"/>
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" Padding="10,8" Click="OnDisconnectProfile">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="#E02020"/>
                                <TextBlock Text="Disconnect Profile"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- VPN adapter list -->
                <Border CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="VPN Network Adapters" FontSize="13" FontWeight="SemiBold"/>
                        <ListView x:Name="VpnAdapterList" MaxHeight="200" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0,4"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="Gray"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="AdapterStatus" FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="Collapsed" x:Name="VpnConnectProgress">
                    <ProgressRing IsActive="True" Width="16" Height="16"/>
                    <TextBlock Text="Connecting…" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="VpnActionStatus" Text="" FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Right: rasdial output + VPN profiles -->
            <StackPanel Grid.Column="1" Spacing="12">

                <!-- Windows VPN profiles -->
                <Border CornerRadius="12" Padding="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="14,10"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock Text="Windows VPN Profiles" FontSize="13" FontWeight="SemiBold"/>
                                <Button HorizontalAlignment="Right" Padding="8,4" Click="OnLoadProfiles">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE72C;" FontSize="11"/>
                                        <TextBlock Text="Load Profiles" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        <ListView x:Name="VpnProfileList" Grid.Row="1" MinHeight="200" SelectionMode="Single"
                                  SelectionChanged="OnProfileSelected">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="14,8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{Binding StatusIcon}" FontSize="14"
                                                  Foreground="{Binding StatusColor}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TunnelType}"
                                                   FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Status}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- rasdial output terminal -->
                <Border CornerRadius="12" Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Command Output" FontSize="12" FontWeight="SemiBold"/>
                        <ScrollViewer Height="140" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="RasOutput"
                                       FontFamily="Cascadia Code, Consolas" FontSize="11"
                                       IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                       Text="Ready. Connect to a VPN profile above."/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
