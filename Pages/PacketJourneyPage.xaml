<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WinNetControl.Pages.PacketJourneyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border CornerRadius="10" Padding="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE704;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Packet Journey" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Visual traceroute · Hop-by-hop analysis · GeoIP · Latency" FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBox x:Name="TargetBox" PlaceholderText="Host or IP  (e.g. google.com)"
                             Width="240" KeyDown="OnTargetBoxKeyDown"/>
                    <Button Padding="12,6" Click="OnTrace" Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE773;" FontSize="13"/>
                            <TextBlock Text="Trace" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Padding="10,6" Click="OnCancel">
                        <FontIcon Glyph="&#xE711;" FontSize="13"/>
                    </Button>
                    <Button Padding="10,6" Click="OnCopy" ToolTipService.ToolTip="Copy results">
                        <FontIcon Glyph="&#xE8C8;" FontSize="13"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="12" Margin="16,14,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Visual hop diagram + hop list -->
            <Border CornerRadius="12" Padding="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="180"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Progress/status bar -->
                    <Border Grid.Row="0" Padding="14,10"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Name="TraceStatus" Text="Enter a host and press Trace."
                                           FontSize="12" VerticalAlignment="Center"/>
                                <ProgressBar x:Name="TraceProgress" IsIndeterminate="True"
                                             Width="120" Visibility="Collapsed" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="SummaryText" Text="" FontSize="11" Foreground="Gray"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Visual hop bar chart (Canvas) -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <Canvas x:Name="HopCanvas" Height="160" MinWidth="600"/>
                    </ScrollViewer>

                    <!-- Hop detail list -->
                    <Border Grid.Row="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Column headers -->
                            <Border Grid.Row="0" Padding="14,7"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Hop"     FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="IP Address"  FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="Hostname / GeoIP" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="3" Text="RTT 1"   FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="4" Text="RTT 2"   FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="5" Text="RTT 3"   FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="6" Text="Latency" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                                </Grid>
                            </Border>
                            <ListView x:Name="HopList" Grid.Row="1" SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="14,5"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="50" Width="26" Height="26"
                                                    Background="{Binding LatencyBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding HopNum}" FontSize="11"
                                                           FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding IpAddress}"
                                                       FontFamily="Consolas" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       IsTextSelectionEnabled="True"/>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{Binding Hostname}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding GeoLabel}" FontSize="10"
                                                           Foreground="Gray"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding Rtt1}"
                                                       FontSize="11" VerticalAlignment="Center" Foreground="Gray"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Rtt2}"
                                                       FontSize="11" VerticalAlignment="Center" Foreground="Gray"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Rtt3}"
                                                       FontSize="11" VerticalAlignment="Center" Foreground="Gray"/>
                                            <TextBlock Grid.Column="6" Text="{Binding AvgLatency}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{Binding LatencyBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Right: GeoIP + analysis -->
            <StackPanel Grid.Column="1" Spacing="12">
                <Border CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Route Analysis" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AnalysisText"
                                   FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                                   Text="Run a trace to see analysis…"/>
                    </StackPanel>
                </Border>

                <!-- Country hop path -->
                <Border CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="GeoIP Path" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="GeoPathText"
                                   FontSize="12" TextWrapping="Wrap"
                                   Text="—"/>
                    </StackPanel>
                </Border>

                <!-- Latency legend -->
                <Border CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Latency Legend" FontSize="12" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="14" Height="14" CornerRadius="2" Background="#107C10"/>
                            <TextBlock Text="&lt;30ms Excellent" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="14" Height="14" CornerRadius="2" Background="#0078D4"/>
                            <TextBlock Text="30-100ms Good" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="14" Height="14" CornerRadius="2" Background="#FBBC05"/>
                            <TextBlock Text="100-300ms Fair" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="14" Height="14" CornerRadius="2" Background="#E02020"/>
                            <TextBlock Text="&gt;300ms Poor / *" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
