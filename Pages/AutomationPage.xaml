<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WinNetControl.Pages.AutomationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border CornerRadius="10" Padding="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xEC58;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Automation" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Scheduled rules · Time-based firewall · Auto DNS flush · Recurring tasks" FontSize="12" Foreground="Gray"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="12" Margin="16,14,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Rule builder -->
            <StackPanel Spacing="12">

                <Border CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Create Scheduled Rule" FontSize="13" FontWeight="SemiBold"/>

                        <TextBox x:Name="RuleLabel" Header="Rule Name"
                                 PlaceholderText="e.g. Block Gaming at Midnight"/>

                        <ComboBox x:Name="ActionCombo" Header="Action" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Flush DNS"                   Tag="flush_dns"/>
                            <ComboBoxItem Content="Block All Internet (Kill)"   Tag="kill_on"/>
                            <ComboBoxItem Content="Restore Internet"            Tag="kill_off"/>
                            <ComboBoxItem Content="Reset Network Stack"         Tag="reset_net"/>
                            <ComboBoxItem Content="Block App by Name"           Tag="block_app"/>
                            <ComboBoxItem Content="Unblock App by Name"         Tag="unblock_app"/>
                            <ComboBoxItem Content="Run DNS Benchmark"           Tag="dns_bench"/>
                            <ComboBoxItem Content="Clear WNC History Log"       Tag="clear_log"/>
                        </ComboBox>

                        <TextBox x:Name="ActionParam" Header="Parameter (for app actions)"
                                 PlaceholderText="App name e.g. chrome.exe"/>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TimePicker x:Name="TriggerTime" Header="Trigger Time"
                                        ClockIdentifier="24HourClock"/>
                            <ComboBox x:Name="RepeatCombo" Grid.Column="1" Header="Repeat"
                                      HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="Once"        Tag="once"/>
                                <ComboBoxItem Content="Daily"       Tag="daily"/>
                                <ComboBoxItem Content="Weekdays"    Tag="weekdays"/>
                                <ComboBoxItem Content="Weekends"    Tag="weekends"/>
                            </ComboBox>
                        </Grid>

                        <ToggleSwitch x:Name="RuleEnabledToggle" Header="Rule enabled" IsOn="True"/>

                        <Button HorizontalAlignment="Stretch" Padding="10,8"
                                Click="OnAddRule" Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="13"/>
                                <TextBlock Text="Add Scheduled Rule"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Quick presets -->
                <Border CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Quick Presets" FontSize="13" FontWeight="SemiBold"/>
                        <Button HorizontalAlignment="Stretch" Padding="10,7" Click="OnPreset" Tag="midnight_flush">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE916;" FontSize="14"/>
                                <TextBlock Text="Flush DNS at Midnight (daily)" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" Padding="10,7" Click="OnPreset" Tag="night_kill">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="#E02020"/>
                                <TextBlock Text="Kill Internet 11PM → 6AM" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" Padding="10,7" Click="OnPreset" Tag="hourly_log">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE9F9;" FontSize="14"/>
                                <TextBlock Text="Clear Log Every 24h" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="AutoStatus" Text="" FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Right: Active rules list + log -->
            <StackPanel Grid.Column="1" Spacing="12">

                <!-- Rules list -->
                <Border CornerRadius="12" Padding="0" MinHeight="300"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="14,10"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock Text="Scheduled Rules" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="RuleCountText" FontSize="11" Foreground="Gray"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ListView x:Name="RulesList" Grid.Row="1" SelectionMode="None" MinHeight="200">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="14,8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ActionDisplay}"
                                                   FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TimeDisplay}"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding RepeatDisplay}"
                                                   FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                                        <Button Grid.Column="4" Padding="4" Click="OnDeleteRule"
                                                Tag="{Binding Id}">
                                            <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#E02020"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Execution log -->
                <Border CornerRadius="12" Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Execution Log" FontSize="12" FontWeight="SemiBold"/>
                        <ScrollViewer Height="130" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="ExecLog"
                                       FontFamily="Consolas" FontSize="11"
                                       IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                       Text="No rules executed yet."/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
