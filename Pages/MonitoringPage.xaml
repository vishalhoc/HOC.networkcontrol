<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinNetControl.Pages.MonitoringPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border CornerRadius="10" Padding="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE9D9;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Real-Time Monitoring" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Live bandwidth · Per-adapter · Top processes" FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Interval:" VerticalAlignment="Center" FontSize="12" Foreground="Gray"/>
                    <ComboBox x:Name="IntervalCombo" SelectedIndex="0" Width="90" SelectionChanged="OnIntervalChanged">
                        <ComboBoxItem Content="1 s"/>
                        <ComboBoxItem Content="2 s"/>
                        <ComboBoxItem Content="5 s"/>
                    </ComboBox>
                    <ToggleButton x:Name="PauseBtn" Padding="10,6" Click="OnPauseToggle">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="13"/>
                            <TextBlock x:Name="PauseBtnText" Text="Pause"/>
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14" Padding="16,14,16,20">

                <!-- ── Hero speed stats row ── -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="10" Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="4">
                            <TextBlock Text="↑  Upload" FontSize="11" Foreground="#0078D4"/>
                            <TextBlock x:Name="HeroUpload" Text="0 KB/s" FontSize="24" FontWeight="Bold" Foreground="#0078D4"/>
                            <TextBlock x:Name="HeroUploadPeak" Text="Peak: 0" FontSize="10" Foreground="Gray"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" CornerRadius="10" Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="4">
                            <TextBlock Text="↓  Download" FontSize="11" Foreground="#107C10"/>
                            <TextBlock x:Name="HeroDownload" Text="0 KB/s" FontSize="24" FontWeight="Bold" Foreground="#107C10"/>
                            <TextBlock x:Name="HeroDownloadPeak" Text="Peak: 0" FontSize="10" Foreground="Gray"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" CornerRadius="10" Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Total Sent (session)" FontSize="11" Foreground="Gray"/>
                            <TextBlock x:Name="HeroSent" Text="0 B" FontSize="24" FontWeight="Bold"/>
                            <TextBlock x:Name="HeroSentRate" Text="" FontSize="10" Foreground="Gray"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" CornerRadius="10" Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Total Received (session)" FontSize="11" Foreground="Gray"/>
                            <TextBlock x:Name="HeroRecv" Text="0 B" FontSize="24" FontWeight="Bold"/>
                            <TextBlock x:Name="HeroRecvRate" Text="" FontSize="10" Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── Main bandwidth graph ── -->
                <Border CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Bandwidth Graph" FontSize="13" FontWeight="SemiBold"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Rectangle Width="16" Height="3" Fill="#0078D4" VerticalAlignment="Center"/>
                                    <TextBlock Text="Upload" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Rectangle Width="16" Height="3" Fill="#107C10" VerticalAlignment="Center"/>
                                    <TextBlock Text="Download" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Canvas x:Name="BandwidthCanvas" Height="180" SizeChanged="OnCanvasSizeChanged"/>
                    </StackPanel>
                </Border>

                <!-- ── Per-adapter breakdown ── -->
                <Border CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Network Adapters" FontSize="13" FontWeight="SemiBold"/>
                        <ListView x:Name="AdapterList" SelectionMode="None" MaxHeight="200">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0,6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}" FontSize="10" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding UpSpeed}" FontSize="12" Foreground="#0078D4" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DownSpeed}" FontSize="12" Foreground="#107C10" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding TotalSent}" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding TotalRecv}" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- ── Top processes by bandwidth ── -->
                <Border CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="Top Processes by Bandwidth" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="Gray"
                                       VerticalAlignment="Center"
                                       Text="Process → Upload → Download → Total"/>
                        </Grid>

                        <!-- Column headers -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Process" FontSize="11" Foreground="Gray"/>
                            <TextBlock Grid.Column="1" Text="↑ Upload" FontSize="11" Foreground="#0078D4"/>
                            <TextBlock Grid.Column="2" Text="↓ Download" FontSize="11" Foreground="#107C10"/>
                            <TextBlock Grid.Column="3" Text="Total" FontSize="11" Foreground="Gray"/>
                            <TextBlock Grid.Column="4" Text="Usage Bar" FontSize="11" Foreground="Gray"/>
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <ListView x:Name="TopProcessList" SelectionMode="None" MaxHeight="320">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0,6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding ProcessName}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding AppType}"
                                                       FontSize="10" Foreground="Gray"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding UploadSpeed, Converter={StaticResource SpeedConverter}}"
                                                   FontSize="12" Foreground="#0078D4" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DownloadSpeed, Converter={StaticResource SpeedConverter}}"
                                                   FontSize="12" Foreground="#107C10" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding TotalDataUsed, Converter={StaticResource SizeConverter}}"
                                                   FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="4"
                                                     Value="{Binding DataUsagePercent}"
                                                     Maximum="100" Height="6" CornerRadius="3"
                                                     VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
