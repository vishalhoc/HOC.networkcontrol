<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WinNetControl.Pages.SecurityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border CornerRadius="10" Padding="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xEA18;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Security Center" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Threat detection · Suspicious connections · Open port risks · GeoIP" FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Padding="10,6" Click="OnScan">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE773;" FontSize="13"/>
                            <TextBlock Text="Scan Now" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,14,16,14" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Score cards row -->
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE7BA;" FontSize="28" Foreground="#E02020" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ThreatCountText" Text="—" FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Suspicious Connections" FontSize="11" Foreground="Gray"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE80F;" FontSize="28" Foreground="#FBBC05" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="RiskyPortCountText" Text="—" FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Risky Open Ports" FontSize="11" Foreground="Gray"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8D7;" FontSize="28" Foreground="#107C10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="AdminStatusText" Text="—" FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Admin Privileges" FontSize="11" Foreground="Gray"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE753;" FontSize="28" Foreground="#0078D4" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="FwRuleCountText" Text="—" FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Active FW Rules" FontSize="11" Foreground="Gray"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Main panels -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- Suspicious connections list -->
                <Border CornerRadius="12" Padding="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="14,10"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="Suspicious &amp; Foreign Connections" FontSize="13" FontWeight="SemiBold"/>
                        </Border>
                        <ListView x:Name="ThreatList" Grid.Row="1" SelectionMode="Single"
                                  SelectionChanged="OnThreatSelected">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="14,8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{Binding ThreatIcon}" FontSize="14"
                                                  Foreground="{Binding ThreatColor}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ProcessName}"
                                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding RemoteIp}" FontSize="12"
                                                       FontFamily="Consolas" IsTextSelectionEnabled="True"/>
                                            <TextBlock Text="{Binding GeoLabel}" FontSize="10" Foreground="Gray"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding RemotePort}"
                                                   FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding ThreatTag}"
                                                   FontSize="10" Foreground="#E02020" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Right actions panel -->
                <StackPanel Grid.Column="1" Spacing="12">

                    <!-- Selected connection actions -->
                    <Border CornerRadius="12" Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Selected Connection" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SelectedIpText" Text="Select a row →" FontSize="11"
                                       Foreground="Gray" TextWrapping="Wrap"/>
                            <Button HorizontalAlignment="Stretch" Padding="10,8" Click="OnBlockSelectedIp">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="#E02020"/>
                                    <TextBlock Text="Block IP via Firewall" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button HorizontalAlignment="Stretch" Padding="10,8" Click="OnBlockSelectedApp">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7EA;" FontSize="14" Foreground="#E02020"/>
                                    <TextBlock Text="Block App via Firewall" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button HorizontalAlignment="Stretch" Padding="10,8" Click="OnBlockSelectedInHosts">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8C4;" FontSize="14" Foreground="#FBBC05"/>
                                    <TextBlock Text="Block IP in Hosts File" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button HorizontalAlignment="Stretch" Padding="10,8" Click="OnGeoLookupSelected">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE704;" FontSize="14"/>
                                    <TextBlock Text="GeoIP Lookup" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Kill switch -->
                    <Border CornerRadius="12" Padding="16"
                            Background="#1AE02020"
                            BorderBrush="#40E02020" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="#E02020"/>
                                <TextBlock Text="Internet Kill Switch" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                                Text="Immediately blocks ALL outbound traffic on all firewall profiles."/>
                            <Button HorizontalAlignment="Stretch" Padding="10,8" Click="OnKillSwitchOn">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="#E02020"/>
                                    <TextBlock Text="KILL SWITCH ON" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button HorizontalAlignment="Stretch" Padding="10,8" Click="OnKillSwitchOff">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE102;" FontSize="13" Foreground="#107C10"/>
                                    <TextBlock Text="Restore Internet" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Risky ports -->
                    <Border CornerRadius="12" Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Risky Listening Ports" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="RiskyPortsText" FontSize="11" Foreground="Gray"
                                       TextWrapping="Wrap" Text="Run scan to check…"/>
                        </StackPanel>
                    </Border>

                    <!-- Action status -->
                    <TextBlock x:Name="SecurityStatus" Text="" FontSize="11"
                               Foreground="Gray" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
