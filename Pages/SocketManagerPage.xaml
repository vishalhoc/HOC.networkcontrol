<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WinNetControl.Pages.SocketManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border CornerRadius="10" Padding="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xEBD2;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Socket Manager" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SocketCountText" FontSize="12" Foreground="Gray" Text="Live socket table — netstat"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox x:Name="ProtoFilter" Width="100" SelectedIndex="0"
                              SelectionChanged="OnProtoFilterChanged">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="TCP"/>
                        <ComboBoxItem Content="UDP"/>
                    </ComboBox>
                    <ComboBox x:Name="StateFilter" Width="140" SelectedIndex="0"
                              SelectionChanged="OnStateFilterChanged">
                        <ComboBoxItem Content="All States"/>
                        <ComboBoxItem Content="LISTENING"/>
                        <ComboBoxItem Content="ESTABLISHED"/>
                        <ComboBoxItem Content="TIME_WAIT"/>
                        <ComboBoxItem Content="CLOSE_WAIT"/>
                    </ComboBox>
                    <TextBox x:Name="SocketSearch" PlaceholderText="Filter IP/port/process…"
                             Width="200" TextChanged="OnSocketSearch"/>
                    <ComboBox x:Name="RefreshRate" Width="100" SelectedIndex="0"
                              SelectionChanged="OnRefreshRateChanged"
                              ToolTipService.ToolTip="Automatic refresh interval">
                        <ComboBoxItem Content="Refresh: Off" Tag="0"/>
                        <ComboBoxItem Content="Every 5s" Tag="5"/>
                        <ComboBoxItem Content="Every 10s" Tag="10"/>
                        <ComboBoxItem Content="Every 30s" Tag="30"/>
                    </ComboBox>
                    <Button Padding="10,6" Click="OnRefreshSockets">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                            <TextBlock Text="Refresh" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,14,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="12" Padding="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Column headers -->
                    <Border Grid.Row="0" Padding="14,8"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Proto"      FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Local Address"   FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="Remote Address"  FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="State"           FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="Process"         FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="5" Text="PID"             FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="6" Text="Action"          FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>

                    <ListView x:Name="SocketList" Grid.Row="1" SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="14,5"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{Binding BlockBorderBrush}" BorderThickness="3,0,0,0" Padding="8,0,0,0">
                                <Grid ColumnSpacing="8">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutSubItem Text="Set app QoS priority"
                                                               ToolTipService.ToolTip="Windows applies this to all traffic from the app. A Windows QoS application rule cannot be limited to one individual socket.">
                                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE9F3;"/></MenuFlyoutSubItem.Icon>
                                                <MenuFlyoutItem Text="High — calls, games, interactive" Click="OnSetSocketQosHigh" Tag="{Binding}"/>
                                                <MenuFlyoutItem Text="Standard — balanced" Click="OnSetSocketQosStandard" Tag="{Binding}"/>
                                                <MenuFlyoutItem Text="Lowest — background work" Click="OnSetSocketQosLow" Tag="{Binding}"/>
                                            </MenuFlyoutSubItem>
                                            <MenuFlyoutSubItem Text="Set QoS — this socket only (IP:Port)"
                                                               ToolTipService.ToolTip="Creates a destination-only policy for the exact remote IP and port. Works regardless of whether the app path is known.">
                                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE81E;"/></MenuFlyoutSubItem.Icon>
                                                <MenuFlyoutItem Text="High — calls, games, interactive" Click="OnSetSocketOnlyQosHigh" Tag="{Binding}"/>
                                                <MenuFlyoutItem Text="Standard — balanced" Click="OnSetSocketOnlyQosStandard" Tag="{Binding}"/>
                                                <MenuFlyoutItem Text="Lowest — background work" Click="OnSetSocketOnlyQosLow" Tag="{Binding}"/>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem Text="Set auto-expire timer…" Click="OnSetSocketQosTimer" Tag="{Binding}">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE916;"/></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyoutSubItem>
                                            <MenuFlyoutItem Text="Open advanced QoS Manager" Click="OnOpenQosManager">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;"/></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator/>
                                            <MenuFlyoutItem Text="Trace Route" Click="OnTraceRoute" Tag="{Binding}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9CE;"/></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Copy Remote IP" Click="OnCopyRemoteIp" Tag="{Binding}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;"/></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="4" Padding="4,2" HorizontalAlignment="Left"
                                            Background="{Binding ProtoBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Proto}" FontSize="10" Foreground="White"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding LocalAddress}"
                                               FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding RemoteAddress}"
                                               FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding State}"
                                               FontSize="11" VerticalAlignment="Center"
                                               Foreground="{Binding StateForeground}"/>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Grid Width="20" Height="20" VerticalAlignment="Center"
                                              ToolTipService.ToolTip="{Binding ProcessPath}">
                                            <FontIcon Glyph="{Binding AppIconGlyph}" FontSize="16" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding AppIcon}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding AppName}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ProcessName}"
                                                       FontSize="10" Foreground="Gray"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="5" Text="{Binding Pid}"
                                               FontSize="11" VerticalAlignment="Center" Foreground="Gray"/>
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Padding="6,3" FontSize="10" Click="OnKillProcess"
                                                Tag="{Binding Pid}" ToolTipService.ToolTip="Kill process">
                                            <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="#E02020"/>
                                        </Button>
                                        <Button Padding="6,3" FontSize="10" Click="OnBlockSocket"
                                                Tag="{Binding}" ToolTipService.ToolTip="{Binding BlockToolTip}">
                                            <FontIcon Glyph="{Binding BlockIcon}" FontSize="10" Foreground="{Binding ActionBrush, Mode=OneWay}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <TextBlock x:Name="SocketStatus" Grid.Row="1" Text="" FontSize="11"
                       Foreground="Gray" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</Page>
