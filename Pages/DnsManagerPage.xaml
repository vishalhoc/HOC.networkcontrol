<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinNetControl.Pages.DnsManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border CornerRadius="10" Padding="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE771;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="DNS Manager" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Configure · Benchmark · Flush · DoH providers" FontSize="12" Foreground="Gray"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14" Padding="16,14,16,24">

                <!-- Current DNS + Quick Apply -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Current DNS -->
                    <Border Grid.Column="0" CornerRadius="12" Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Current DNS Servers" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CurrentDnsText" Text="Loading…"
                                       FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True"/>
                            <Button Padding="10,6" Click="OnRefreshDns" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                                    <TextBlock Text="Refresh" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Quick apply -->
                    <Border Grid.Column="1" CornerRadius="12" Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Quick Apply Preset" FontSize="13" FontWeight="SemiBold"/>
                            <ComboBox x:Name="AdapterCombo" Header="Network Adapter" HorizontalAlignment="Stretch"/>
                            <ComboBox x:Name="DnsPresetCombo" Header="DNS Provider" HorizontalAlignment="Stretch"
                                      SelectedIndex="0" SelectionChanged="OnPresetChanged">
                                <ComboBoxItem Content="Google (8.8.8.8 / 8.8.4.4)" Tag="8.8.8.8|8.8.4.4"/>
                                <ComboBoxItem Content="Cloudflare (1.1.1.1 / 1.0.0.1)" Tag="1.1.1.1|1.0.0.1"/>
                                <ComboBoxItem Content="OpenDNS (208.67.222.222 / 208.67.220.220)" Tag="208.67.222.222|208.67.220.220"/>
                                <ComboBoxItem Content="Quad9 (9.9.9.9 / 149.112.112.112)" Tag="9.9.9.9|149.112.112.112"/>
                                <ComboBoxItem Content="Cloudflare Malware Block (1.1.1.2)" Tag="1.1.1.2|1.0.0.2"/>
                                <ComboBoxItem Content="Cloudflare Adult Block (1.1.1.3)" Tag="1.1.1.3|1.0.0.3"/>
                                <ComboBoxItem Content="DHCP (auto)" Tag="dhcp"/>
                                <ComboBoxItem Content="Custom…" Tag="custom"/>
                            </ComboBox>
                            <StackPanel x:Name="CustomDnsPanel" Spacing="8" Visibility="Collapsed">
                                <TextBox x:Name="CustomPrimary" Header="Primary DNS" PlaceholderText="e.g. 8.8.8.8"/>
                                <TextBox x:Name="CustomSecondary" Header="Secondary DNS" PlaceholderText="e.g. 8.8.4.4"/>
                            </StackPanel>
                            <Button Padding="12,6" Click="OnApplyDns" Style="{ThemeResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE73E;" FontSize="13"/>
                                    <TextBlock Text="Apply DNS"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="ApplyStatus" Text="" FontSize="11" Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- DNS Benchmark -->
                <Border CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="DNS Benchmark" FontSize="13" FontWeight="SemiBold"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Padding="10,6" Click="OnRunBenchmark" x:Name="BenchBtn">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xEC4A;" FontSize="13"/>
                                        <TextBlock x:Name="BenchBtnText" Text="Run Benchmark"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ProgressBar x:Name="BenchProgress" IsIndeterminate="False"
                                     Visibility="Collapsed" Height="4"/>
                        <!-- Results list -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="DNS Server" FontSize="11" Foreground="Gray"/>
                            <TextBlock Grid.Column="1" Text="Min" FontSize="11" Foreground="Gray"/>
                            <TextBlock Grid.Column="2" Text="Avg" FontSize="11" Foreground="Gray"/>
                            <TextBlock Grid.Column="3" Text="Max" FontSize="11" Foreground="Gray"/>
                            <TextBlock Grid.Column="4" Text="Loss" FontSize="11" Foreground="Gray"/>
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                        <ListView x:Name="BenchmarkList" SelectionMode="Single"
                                  DoubleTapped="OnBenchResultDoubleTapped" MaxHeight="300">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0,6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Address}" FontSize="10" Foreground="Gray" FontFamily="Consolas"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding MinMs}" FontSize="12"
                                                   Foreground="{Binding RatingBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding AvgMs}" FontSize="12"
                                                   Foreground="{Binding RatingBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding MaxMs}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Loss}" FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="Double-click a result to apply that DNS server" FontSize="11" Foreground="Gray"/>
                    </StackPanel>
                </Border>

                <!-- Quick actions row -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" HorizontalAlignment="Stretch" Padding="14,12" Click="OnFlushDns">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE74D;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Flush DNS Cache" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Text="ipconfig /flushdns" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" HorizontalAlignment="Stretch" Padding="14,12" Click="OnDisplayDnsCache">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE81C;" FontSize="22" Foreground="#107C10"/>
                            <TextBlock Text="View DNS Cache" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Text="ipconfig /displaydns" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" HorizontalAlignment="Stretch" Padding="14,12" Click="OnRegisterDns">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE72C;" FontSize="22" Foreground="#FBBC05"/>
                            <TextBlock Text="Register DNS" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Text="ipconfig /registerdns" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- DNS output terminal -->
                <Border CornerRadius="12"
                        Background="#0A000000"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                        x:Name="OutputBorder" Visibility="Collapsed">
                    <ScrollViewer Height="200" Padding="14,10">
                        <TextBlock x:Name="OutputText"
                                   FontFamily="Cascadia Code, Consolas"
                                   FontSize="12" IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
