<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinNetControl.Pages.PortScannerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border CornerRadius="10" Padding="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE8C4;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Port Scanner" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="TCP port scan with service identification" FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="OpenCount" Text="0 open" FontSize="12"
                               Foreground="#107C10" VerticalAlignment="Center"/>
                    <Button x:Name="ScanBtn" Padding="12,6" Click="OnScanPorts"
                            Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE968;" FontSize="13"/>
                            <TextBlock x:Name="ScanBtnText" Text="Scan Ports"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" RowSpacing="12" Margin="16,14,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Config -->
            <Border Grid.Row="0" CornerRadius="10" Padding="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TargetBox" Header="Target (IP or hostname)"
                                 PlaceholderText="192.168.1.1 or google.com" Text="127.0.0.1"/>
                        <NumberBox x:Name="FromPort" Grid.Column="1" Header="From Port"
                                   Value="1" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Inline"/>
                        <NumberBox x:Name="ToPort" Grid.Column="2" Header="To Port"
                                   Value="1024" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Inline"/>
                        <NumberBox x:Name="TimeoutMs" Grid.Column="3" Header="Timeout (ms)"
                                   Value="400" Minimum="50" Maximum="5000" SpinButtonPlacementMode="Inline"/>
                        <CheckBox x:Name="ShowClosed" Grid.Column="4" Content="Show Closed"
                                  VerticalAlignment="Bottom" Padding="8,0,0,0"/>
                    </Grid>
                    <!-- Preset ranges -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Presets:" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                        <Button Padding="8,4" FontSize="11" Click="OnPresetRange" Tag="1-1024">
                            <TextBlock Text="Well-known (1–1024)"/>
                        </Button>
                        <Button Padding="8,4" FontSize="11" Click="OnPresetRange" Tag="1-65535">
                            <TextBlock Text="Full scan (1–65535)"/>
                        </Button>
                        <Button Padding="8,4" FontSize="11" Click="OnPresetRange" Tag="1024-49151">
                            <TextBlock Text="Registered (1024–49151)"/>
                        </Button>
                        <Button Padding="8,4" FontSize="11" Click="OnPresetRange" Tag="3000-10000">
                            <TextBlock Text="Common App (3000–10000)"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Progress bar + status -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ProgressBar x:Name="ScanProgress" Height="6" CornerRadius="3"
                             Maximum="100" Value="0" Visibility="Collapsed" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="Idle"
                           FontSize="11" Foreground="Gray" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>

            <!-- Results -->
            <Border Grid.Row="2" CornerRadius="12" Padding="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="14,10"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Port" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="State" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="Service" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="Response" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>
                    <ListView x:Name="ResultsList" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="14,8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Port}" FontSize="13" FontWeight="SemiBold"
                                               FontFamily="Consolas" VerticalAlignment="Center"
                                               Foreground="{Binding StateBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="12"
                                               Foreground="{Binding StateBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Service}" FontSize="12"
                                               VerticalAlignment="Center" Foreground="Gray"/>
                                    <TextBlock Grid.Column="3" Text="{Binding ResponseMs}"
                                               FontSize="12" VerticalAlignment="Center" Foreground="Gray"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
