<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WinNetControl.Pages.LogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border CornerRadius="10" Padding="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE9F9;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Logs &amp; Events" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="WNC activity log · Windows Event Log network events" FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ToggleSwitch x:Name="LiveTailSwitch" Header="Live tail" IsOn="True"
                                  Toggled="OnLiveTailToggled"/>
                    <Button Padding="10,6" Click="OnExportLog">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE898;" FontSize="13"/>
                            <TextBlock Text="Export" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Padding="10,6" Click="OnClearLog">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#E02020"/>
                            <TextBlock Text="Clear" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" RowSpacing="12" Margin="16,14,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Filters -->
            <Border Grid.Row="0" CornerRadius="12" Padding="14,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBox x:Name="LogSearchBox" PlaceholderText="Search logs…" Width="200"
                             TextChanged="OnLogSearch"/>
                    <ComboBox x:Name="EventTypeFilter" Header="Type" Width="160"
                              SelectionChanged="OnFilterChanged" SelectedIndex="0">
                        <ComboBoxItem Content="All Types"/>
                        <ComboBoxItem Content="Firewall Rule"/>
                        <ComboBoxItem Content="Process Start"/>
                        <ComboBoxItem Content="Security"/>
                        <ComboBoxItem Content="Routing"/>
                        <ComboBoxItem Content="QoS"/>
                    </ComboBox>
                    <TextBlock x:Name="LogCountText" FontSize="11" Foreground="Gray" VerticalAlignment="Bottom"/>
                </StackPanel>
            </Border>

            <!-- WNC App Log -->
            <Border Grid.Row="1" CornerRadius="12" Padding="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="14,8"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="WinNetControl Activity Log" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <ListView x:Name="AppLogList" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="14,5"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimestampString}" FontSize="11"
                                               Foreground="Gray" VerticalAlignment="Center"
                                               FontFamily="Consolas"/>
                                    <Border Grid.Column="1" CornerRadius="4" Padding="4,2"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="#200078D4">
                                        <TextBlock Text="{Binding EventType}" FontSize="10"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding AppName}"
                                               FontSize="11" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Details}"
                                               FontSize="11" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               IsTextSelectionEnabled="True"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Windows Event Log -->
            <Border Grid.Row="2" CornerRadius="12" Padding="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="14,8"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="Windows Event Log — Network / Firewall" FontSize="12" FontWeight="SemiBold"/>
                            <Button HorizontalAlignment="Right" Padding="8,4" Click="OnLoadEventLog">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE72C;" FontSize="11"/>
                                    <TextBlock Text="Load Events" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    <ListView x:Name="EventLogList" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="14,5"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeStr}" FontSize="11"
                                               FontFamily="Consolas" VerticalAlignment="Center" Foreground="Gray"/>
                                    <Border Grid.Column="1" CornerRadius="4" Padding="4,2"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{Binding LevelBrush}">
                                        <TextBlock Text="{Binding Level}" FontSize="10" Foreground="White"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Source}"
                                               FontSize="11" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Message}"
                                               FontSize="11" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               IsTextSelectionEnabled="True"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
