<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinNetControl.Pages.WirelessPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border CornerRadius="10" Padding="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xEC3B;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Wireless &amp; Wi-Fi" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Connected network · Signal · Nearby networks · Profiles" FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Padding="12,6" Click="OnRefresh" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                        <TextBlock Text="Refresh" FontSize="12"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14" Padding="16,14,16,24">

                <!-- Current connection card -->
                <Border CornerRadius="12" Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Signal strength icon -->
                        <Border CornerRadius="12" Width="64" Height="64"
                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <FontIcon x:Name="SignalIcon" Glyph="&#xEC3B;" FontSize="32"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock x:Name="ConnectedSsid" Text="Not connected"
                                       FontSize="20" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Name="ConnSignal" Text="Signal: —"
                                           FontSize="12" Foreground="Gray"/>
                                <TextBlock x:Name="ConnBand" Text=""
                                           FontSize="12" Foreground="Gray"/>
                                <TextBlock x:Name="ConnProtocol" Text=""
                                           FontSize="12" Foreground="Gray"/>
                                <TextBlock x:Name="ConnChannel" Text=""
                                           FontSize="12" Foreground="Gray"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Signal meter -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                            <TextBlock x:Name="SignalPct" Text="—"
                                       FontSize="28" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Signal" FontSize="10" Foreground="Gray"
                                       HorizontalAlignment="Center"/>
                            <ProgressBar x:Name="SignalBar" Width="100" Height="8"
                                         Maximum="100" Value="0" CornerRadius="4"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Connection details grid -->
                <Border CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Connection Details" FontSize="13" FontWeight="SemiBold"/>
                        <Grid x:Name="ConnDetailsGrid" ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="BSSID" Foreground="Gray" FontSize="11"/>
                            <TextBlock x:Name="ConnBssid" Grid.Column="1" FontSize="11" FontFamily="Consolas" IsTextSelectionEnabled="True" Text="—"/>
                            <TextBlock Grid.Column="2" Text="Authentication" Foreground="Gray" FontSize="11"/>
                            <TextBlock x:Name="ConnAuth" Grid.Column="3" FontSize="11" Text="—"/>

                            <TextBlock Grid.Row="1" Text="Cipher" Foreground="Gray" FontSize="11"/>
                            <TextBlock x:Name="ConnCipher" Grid.Row="1" Grid.Column="1" FontSize="11" Text="—"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Radio Type" Foreground="Gray" FontSize="11"/>
                            <TextBlock x:Name="ConnRadio" Grid.Row="1" Grid.Column="3" FontSize="11" Text="—"/>

                            <TextBlock Grid.Row="2" Text="Rx Rate" Foreground="Gray" FontSize="11"/>
                            <TextBlock x:Name="ConnRxRate" Grid.Row="2" Grid.Column="1" FontSize="11" Text="—"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Tx Rate" Foreground="Gray" FontSize="11"/>
                            <TextBlock x:Name="ConnTxRate" Grid.Row="2" Grid.Column="3" FontSize="11" Text="—"/>

                            <TextBlock Grid.Row="3" Text="IP Address" Foreground="Gray" FontSize="11"/>
                            <TextBlock x:Name="ConnIp" Grid.Row="3" Grid.Column="1" FontSize="11" IsTextSelectionEnabled="True" Text="—"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Profile" Foreground="Gray" FontSize="11"/>
                            <TextBlock x:Name="ConnProfile" Grid.Row="3" Grid.Column="3" FontSize="11" Text="—"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Nearby networks -->
                <Border CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="Nearby Networks" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="NetworkCount" HorizontalAlignment="Right"
                                       FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SSID" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Signal" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="Auth" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="Band" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="Channel" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <ListView x:Name="NetworkList" SelectionMode="None" MaxHeight="350">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0,6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Ssid}" FontSize="12" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Bssid}" FontSize="9"
                                                       Foreground="Gray" FontFamily="Consolas"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Signal}" FontSize="12"
                                                       Foreground="{Binding SignalBrush}"/>
                                            <ProgressBar Value="{Binding SignalPct}" Maximum="100"
                                                         Height="3" CornerRadius="2"
                                                         Width="60" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Auth}"
                                                   FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Band}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Channel}"
                                                   FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Wi-Fi Profiles -->
                <Border CornerRadius="12" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="Saved Wi-Fi Profiles" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                                <Button Padding="8,4" FontSize="11"
                                        Click="OnConnectToProfile"
                                        ToolTipService.ToolTip="Connect to selected profile">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xEC3B;" FontSize="12"/>
                                        <TextBlock Text="Connect"/>
                                    </StackPanel>
                                </Button>
                                <Button Padding="8,4" FontSize="11"
                                        Click="OnShowProfilePassword"
                                        ToolTipService.ToolTip="Show saved password (requires admin)">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE8D4;" FontSize="12"/>
                                        <TextBlock Text="Password"/>
                                    </StackPanel>
                                </Button>
                                <Button Padding="8,4" FontSize="11"
                                        Click="OnDeleteProfile">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                        <TextBlock Text="Delete"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ListView x:Name="ProfileList" MaxHeight="200">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0,6"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xEC3B;" FontSize="16" Foreground="Gray"/>
                                        <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="ProfileStatus" Text="" FontSize="11" Foreground="Gray"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
