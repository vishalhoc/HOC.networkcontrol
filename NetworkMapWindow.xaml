<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinNetControl.NetworkMapWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="16,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8EF;" FontSize="20"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <StackPanel>
                        <TextBlock x:Name="AppNameHeader" Text="Network Map"
                                   FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AppSubtitle" Text="Request and response path visualization"
                                   FontSize="11" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Click="OnRefreshClicked" Padding="10,6"
                            ToolTipService.ToolTip="Refresh map">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                    </Button>
                    <!-- Legend -->
                    <Border CornerRadius="6" Padding="10,6"
                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="10" Height="10" Fill="#107C10"/>
                                <TextBlock Text="Active" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="10" Height="10" Fill="#CC3300"/>
                                <TextBlock Text="Blocked" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="10" Height="10" Fill="#888888"/>
                                <TextBlock Text="Inactive" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Map canvas scroll area -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Enabled">
            <Canvas x:Name="MapCanvas" Width="1400" Height="700"/>
        </ScrollViewer>

        <!-- Status / Info bar -->
        <Border Grid.Row="2" Padding="16,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="InfoText"
                           Text="The map shows how network requests flow from your app through Windows Firewall, AdGuard (if active), your network adapter, gateway, DNS server, and to remote servers."
                           FontSize="11" Foreground="Gray" VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
                <TextBlock Grid.Column="1" x:Name="ConnectionCountText"
                           FontSize="11" Foreground="Gray" VerticalAlignment="Center"
                           Margin="16,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
