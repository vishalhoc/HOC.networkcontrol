<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinNetControl.HostsManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- quick-block bar -->
            <RowDefinition Height="Auto"/>   <!-- search / filter bar -->
            <RowDefinition Height="*"/>      <!-- list -->
            <RowDefinition Height="Auto"/>   <!-- bottom bar -->
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Padding="16,12,16,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Hosts File Manager" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="HostsPathText" Foreground="Gray" FontSize="11"
                               FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Click="OnRefresh" Padding="10,6" ToolTipService.ToolTip="Reload from disk">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                            <TextBlock Text="Refresh" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Click="OnOpenNotepad" Padding="10,6" ToolTipService.ToolTip="Open hosts file in elevated Notepad">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE8A5;" FontSize="12"/>
                            <TextBlock Text="Open in Notepad" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <!-- Backup (#31) -->
                    <Button Click="OnBackupHosts" Padding="10,6"
                            ToolTipService.ToolTip="Save a timestamped backup of hosts file to Desktop">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE792;" FontSize="12"/>
                            <TextBlock Text="Backup" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <!-- Restore (#31) -->
                    <Button Click="OnRestoreHosts" Padding="10,6"
                            ToolTipService.ToolTip="Restore hosts file from a backup on Desktop">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE7BA;" FontSize="12"/>
                            <TextBlock Text="Restore Backup" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Click="OnResetDefault" Padding="10,6"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            ToolTipService.ToolTip="Restore Windows default hosts file">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE777;" FontSize="12"/>
                            <TextBlock Text="Reset to Default" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Quick Block Bar ─────────────────────────────────────────────── -->
        <Border Grid.Row="1" Margin="12,8,12,0" Padding="12,10"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>    <!-- label -->
                    <ColumnDefinition Width="2*"/>      <!-- hostname -->
                    <ColumnDefinition Width="130"/>     <!-- IP fixed width -->
                    <ColumnDefinition Width="Auto"/>    <!-- block btn -->
                    <ColumnDefinition Width="Auto"/>    <!-- add btn -->
                </Grid.ColumnDefinitions>

                <TextBlock Text="Quick Block:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>

                <TextBox x:Name="QuickHostnameBox" Grid.Column="1"
                         PlaceholderText="Enter hostname to block  (e.g. ads.example.com)"
                         KeyDown="OnQuickBlockKeyDown"/>

                <TextBox x:Name="QuickIpBox" Grid.Column="2"
                         PlaceholderText="Redirect IP" Text="0.0.0.0"/>

                <Button Grid.Column="3" Click="OnQuickBlock" Padding="12,7"
                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xF140;" FontSize="12" Foreground="White"/>
                        <TextBlock Text="Block Domain" FontSize="12" Foreground="White"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="4" Click="OnAddEntry" Padding="12,7">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE710;" FontSize="12"/>
                        <TextBlock Text="Add Entry" FontSize="12"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ── Search + Filter Bar ────────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="12,8,12,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox" PlaceholderText="&#xE71E;  Search hostname, IP or comment…"
                     TextChanged="OnSearchChanged"/>

            <ToggleButton x:Name="ShowDisabledToggle" Grid.Column="1"
                          Content="Show Disabled" IsChecked="True"
                          Click="OnFilterChanged" Padding="10,6"/>

            <ToggleButton x:Name="ShowCommentsToggle" Grid.Column="2"
                          Content="Show Comments" IsChecked="False"
                          Click="OnFilterChanged" Padding="10,6"/>

            <TextBlock x:Name="EntryCountText" Grid.Column="3"
                       VerticalAlignment="Center" Foreground="Gray" FontSize="11" Margin="4,0"/>
        </Grid>

        <!-- ── Hosts List ──────────────────────────────────────────────────── -->
        <Border Grid.Row="3" Margin="12,8,12,0" CornerRadius="8"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Column header row -->
                <Grid Grid.Row="0" Padding="12,7,12,7"
                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>     <!-- # -->
                        <ColumnDefinition Width="120"/>    <!-- IP -->
                        <ColumnDefinition Width="*"/>      <!-- Hostname -->
                        <ColumnDefinition Width="130"/>    <!-- Comment -->
                        <ColumnDefinition Width="110"/>    <!-- Source App -->
                        <ColumnDefinition Width="110"/>    <!-- Actions -->
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="#"           FontSize="11" FontWeight="SemiBold" Foreground="Gray" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"  Text="IP Address"   FontSize="11" FontWeight="SemiBold" Foreground="Gray" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2"  Text="Hostname"     FontSize="11" FontWeight="SemiBold" Foreground="Gray" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3"  Text="Comment"      FontSize="11" FontWeight="SemiBold" Foreground="Gray" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4"  Text="Source App"   FontSize="11" FontWeight="SemiBold" Foreground="Gray" VerticalAlignment="Center"
                               ToolTipService.ToolTip="App that added this entry via WinNetControl"/>
                    <TextBlock Grid.Column="5"  Text="Actions"      FontSize="11" FontWeight="SemiBold" Foreground="Gray" VerticalAlignment="Center"/>
                </Grid>

                <!-- Entries -->
                <ListView x:Name="HostsList" Grid.Row="1"
                          SelectionMode="Multiple" IsItemClickEnabled="False"
                          ItemClick="OnHostsItemClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding"                   Value="0"/>
                            <Setter Property="MinHeight"                 Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,6,12,6" ColumnSpacing="8"
                                  Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <!-- Line # -->
                                <TextBlock Text="{Binding LineIndex}"
                                           FontSize="11" Foreground="Gray"
                                           VerticalAlignment="Center"/>

                                <!-- IP Address -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayIp}"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="{Binding IsEnabled, Converter={StaticResource BoolToBrushConverter}}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{Binding Ip}"/>

                                <!-- Hostname -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding DisplayHostname}"
                                           FontSize="12"
                                           Opacity="{Binding IsEnabled, Converter={StaticResource BoolToOpacityConverter}}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{Binding Hostname}"/>

                                <!-- Comment -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Comment}"
                                           FontSize="11" FontStyle="Italic" Foreground="Gray"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{Binding Comment}"/>

                                <!-- Source App badge -->
                                <Border Grid.Column="4" CornerRadius="4" Padding="6,2"
                                        VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Border.Background>
                                        <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.12"/>
                                    </Border.Background>
                                    <TextBlock Text="{Binding DisplaySource}"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{Binding DisplaySource}"/>
                                </Border>

                                <!-- Actions: Enable toggle + Delete -->
                                <StackPanel Grid.Column="5" Orientation="Horizontal"
                                            Spacing="6" VerticalAlignment="Center">
                                    <ToggleButton IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  Click="OnToggleEntry"
                                                  Padding="8,3" MinWidth="42"
                                                  ToolTipService.ToolTip="Enable / Disable entry">
                                        <TextBlock
                                                   Text="{Binding IsEnabled, Converter={StaticResource BoolToOnOffConverter}}"
                                                   FontSize="10" FontWeight="SemiBold"/>
                                    </ToggleButton>
                                    <Button Click="OnRemoveEntry" Padding="6,3"
                                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                            ToolTipService.ToolTip="Remove this entry">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- ── Bottom Action Bar ──────────────────────────────────────────── -->
        <Grid Grid.Row="4" Margin="12,8,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Click="OnRemoveSelected" Padding="12,7"
                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                    ToolTipService.ToolTip="Remove all selected entries">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                    <TextBlock Text="Remove Selected" FontSize="12"/>
                </StackPanel>
            </Button>

            <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center"
                       Margin="14,0" FontSize="12"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       TextTrimming="CharacterEllipsis"/>

            <Button Grid.Column="2" Click="OnSaveChanges" Padding="18,7" Margin="0,0,0,0"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Write changes to disk and flush DNS cache">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74E;" FontSize="13"/>
                    <TextBlock Text="Save Changes" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
