<Window
    x:Class="WinNetControl.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinNetControl.Models"
    mc:Ignorable="d"
    Title="Settings">

    <ScrollViewer>
        <Grid Padding="24">
            <StackPanel Spacing="16">
                <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold"/>
                
                <TextBlock Text="Dependencies" FontWeight="SemiBold" Margin="0,12,0,0"/>
                <Button Content="Install Required Dependencies (Npcap, etc.)" Click="OnInstallDependencies" HorizontalAlignment="Stretch"/>
                <TextBlock x:Name="DependencyStatusText" Text="Status: Unknown" Foreground="Gray" FontSize="12"/>

                <TextBlock Text="Widget Settings" FontWeight="SemiBold" Margin="0,12,0,0"/>
                
                <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="16">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Opacity:" VerticalAlignment="Center"/>
                    <Slider Grid.Row="0" Grid.Column="1" Minimum="10" Maximum="100" Value="{x:Bind ViewModel.CurrentConfig.WidgetOpacity, Mode=TwoWay}" Width="150" HorizontalAlignment="Left" ValueChanged="OnWidgetSettingChanged"/>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Disable Transparency:" VerticalAlignment="Center"/>
                    <ToggleSwitch Grid.Row="1" Grid.Column="1" IsOn="{x:Bind ViewModel.CurrentConfig.WidgetDisableTransparency, Mode=TwoWay}" Toggled="OnWidgetSettingChanged"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Refresh Rate (ms):" VerticalAlignment="Center"/>
                    <NumberBox Grid.Row="2" Grid.Column="1" Minimum="100" Maximum="5000" Value="{x:Bind ViewModel.CurrentConfig.WidgetRefreshRateMs, Mode=TwoWay}" Width="150" HorizontalAlignment="Left" ValueChanged="OnWidgetSettingChanged"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Font Size:" VerticalAlignment="Center"/>
                    <Slider Grid.Row="3" Grid.Column="1" Minimum="8" Maximum="32" Value="{x:Bind ViewModel.CurrentConfig.WidgetFontSize, Mode=TwoWay}" Width="150" HorizontalAlignment="Left" ValueChanged="OnWidgetSettingChanged"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Dimensions (W x H):" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <NumberBox Minimum="100" Maximum="1000" Value="{x:Bind ViewModel.CurrentConfig.WidgetWidth, Mode=TwoWay}" Width="80" ValueChanged="OnWidgetSettingChanged"/>
                        <TextBlock Text="x" VerticalAlignment="Center"/>
                        <NumberBox Minimum="50" Maximum="1000" Value="{x:Bind ViewModel.CurrentConfig.WidgetHeight, Mode=TwoWay}" Width="80" ValueChanged="OnWidgetSettingChanged"/>
                    </StackPanel>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Layout:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="5" Grid.Column="1" SelectedItem="{x:Bind ViewModel.CurrentConfig.WidgetLayout, Mode=TwoWay}" Width="150" SelectionChanged="OnWidgetSettingChanged">
                        <x:String>Vertical</x:String>
                        <x:String>Horizontal</x:String>
                    </ComboBox>
                </Grid>
                <TextBlock Text="Proxy Settings (HTTP Capture)" FontWeight="SemiBold" Margin="0,12,0,0"/>
                <TextBlock Text="Requires administrative privileges to install certificate." FontSize="12" Foreground="Gray"/>
                
                <ToggleSwitch Header="Enable System Proxy (Capture All Browsers)" IsOn="{x:Bind ViewModel.CurrentConfig.EnableSystemProxy, Mode=TwoWay}" Toggled="OnWidgetSettingChanged"/>
                
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Install Certificate" Click="OnInstallCertificateClicked"/>
                    <Button Content="Uninstall Certificate" Click="OnUninstallCertificateClicked"/>
                </StackPanel>
                
                <TextBlock Text="Network Adapters" FontWeight="SemiBold" Margin="0,12,0,0"/>
                <TextBlock Text="Select which adapters to apply blocking rules to:" FontSize="12" Foreground="Gray"/>
                <ListView ItemsSource="{x:Bind ViewModel.NetworkAdapters, Mode=OneWay}" MaxHeight="200" BorderThickness="1" BorderBrush="LightGray" CornerRadius="4">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:NetworkAdapterInfo">
                            <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Margin="0,4"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                
                <StackPanel Margin="0,32,0,0">
                    <TextBlock Text="{x:Bind AppVersion, Mode=OneTime}" Foreground="Gray" FontSize="12"/>
                    <TextBlock Text="{x:Bind BuildDate, Mode=OneTime}" Foreground="Gray" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
