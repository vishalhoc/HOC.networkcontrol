<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinNetControl.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinNetControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <NavigationView x:Name="NavView"
                        PaneDisplayMode="Left"
                        CompactPaneLength="48"
                        OpenPaneLength="220"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="NavView_SelectionChanged"
                        Loaded="NavView_Loaded"
                        PaneOpening="NavView_PaneOpening"
                        PaneClosing="NavView_PaneClosing">

            <!-- ═══ Custom Header Bar ═══ -->
            <NavigationView.Header>
                <Grid x:Name="HeaderBar" Padding="12,8,12,8"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Title + live speed badge -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE774;" FontSize="16"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="AppTitleText"
                                       Text="WinNetControl"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Live global speeds pill -->
                        <Border CornerRadius="20" Padding="12,4"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE898;" FontSize="11" Foreground="#0078D4"/>
                                    <TextBlock x:Name="HeaderUpText" FontSize="11" Foreground="#0078D4" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="70"/>
                                </StackPanel>
                                <Rectangle Width="1" Height="12" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE896;" FontSize="11" Foreground="#107C10"/>
                                    <TextBlock x:Name="HeaderDownText" FontSize="11" Foreground="#107C10" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="70"/>
                                </StackPanel>
                                <Rectangle Width="1" Height="12" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center"/>
                                <Border x:Name="HeaderBlockedBadge" CornerRadius="10" Padding="8,2"
                                        Visibility="Collapsed"
                                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <FontIcon Glyph="&#xF140;" FontSize="9" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                        <TextBlock x:Name="HeaderBlockedText" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right: Global action buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <ToggleButton IsChecked="{x:Bind ViewModel.BlockNewApps, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Auto-block every newly detected process"
                                      Padding="8,5">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xF140;" FontSize="13"/>
                                <TextBlock Text="Block New" FontSize="11"/>
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton IsChecked="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Start with Windows"
                                      Padding="8,5">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE7C8;" FontSize="13"/>
                                <TextBlock Text="Auto-Start" FontSize="11"/>
                            </StackPanel>
                        </ToggleButton>

                        <Button Padding="8,5" Click="OnThemeToggleClicked" ToolTipService.ToolTip="Toggle theme">
                            <FontIcon x:Name="ThemeIcon" Glyph="&#xE708;" FontSize="15"/>
                        </Button>

                        <Button Padding="8,5" Click="OnToggleGlobalWidget" ToolTipService.ToolTip="Global speed widget">
                            <FontIcon Glyph="&#xE8B7;" FontSize="15"/>
                        </Button>

                        <Button Padding="8,5" Click="OnMinimizeToTrayClicked" ToolTipService.ToolTip="Minimize to system tray">
                            <FontIcon Glyph="&#xE921;" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </NavigationView.Header>

            <!-- ═══ Sidebar Navigation Items ═══ -->
            <NavigationView.MenuItems>

                <!-- ── OVERVIEW ── -->
                <NavigationViewItemHeader Content="OVERVIEW"/>

                <NavigationViewItem x:Name="NavDashboard"
                                    Tag="Dashboard"
                                    ToolTipService.ToolTip="Dashboard — Live network overview">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Dashboard"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavConnections"
                                    Tag="Connections"
                                    ToolTipService.ToolTip="Connection Manager — all apps &amp; traffic">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9CE;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Connections" VerticalAlignment="Center"/>
                            <!-- UX#11: live status dot — green=clean, orange=blocked apps exist -->
                            <Ellipse x:Name="NavConnDot" Width="7" Height="7"
                                     Fill="#10B981" VerticalAlignment="Center"
                                     ToolTipService.ToolTip="All apps unblocked"/>
                        </StackPanel>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavMonitoring"
                                    Tag="Monitoring"
                                    ToolTipService.ToolTip="Real-time monitoring graphs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Monitoring"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <!-- ── NETWORK ── -->
                <NavigationViewItemHeader Content="NETWORK"/>

                <NavigationViewItem x:Name="NavInterfaces"
                                    Tag="Interfaces"
                                    ToolTipService.ToolTip="Network Interfaces &amp; Adapters">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE839;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Interfaces"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavIpConfig"
                                    Tag="IpConfig"
                                    ToolTipService.ToolTip="IP Configuration — ipconfig replacement">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="IP Config"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavDns"
                                    Tag="Dns"
                                    ToolTipService.ToolTip="DNS Manager — benchmark, DoH, blocklists">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE771;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="DNS Manager"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavHosts"
                                    Tag="Hosts"
                                    ToolTipService.ToolTip="Hosts File Manager">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71B;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Hosts File"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavWireless"
                                    Tag="Wireless"
                                    ToolTipService.ToolTip="Wi-Fi Analyzer &amp; Wireless Tools">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC3B;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Wireless"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <!-- ── PENTESTING ── -->
                <NavigationViewItemHeader Content="PENTESTING"/>

                <NavigationViewItem x:Name="NavWifiPentest"
                                    Tag="WifiPentest"
                                    ToolTipService.ToolTip="Wi-Fi Pentesting — Aircrack-ng / Hashcat via WSL">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FB;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Wi-Fi Pentest"/>
                            <Border CornerRadius="3" Padding="4,1"
                                    Background="#22E81123" BorderBrush="#44E81123" BorderThickness="1">
                                <TextBlock Text="EDU" FontSize="9" FontWeight="Bold" Foreground="#E81123"/>
                            </Border>
                        </StackPanel>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavHashcat"
                                    Tag="Hashcat"
                                    ToolTipService.ToolTip="Hashcat — Native Windows GPU password cracker (no WSL needed)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D4;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="GPU Cracker"/>
                            <Border CornerRadius="3" Padding="4,1"
                                    Background="#220078D4" BorderBrush="#440078D4" BorderThickness="1">
                                <TextBlock Text="WIN" FontSize="9" FontWeight="Bold" Foreground="#0078D4"/>
                            </Border>
                        </StackPanel>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <!-- ── SECURITY ── -->
                <NavigationViewItemHeader Content="SECURITY"/>

                <NavigationViewItem x:Name="NavFirewall"
                                    Tag="Firewall"
                                    ToolTipService.ToolTip="Firewall Manager">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BA;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Firewall" VerticalAlignment="Center"/>
                            <!-- UX#11: live status dot — green=active rules exist, gray=no rules -->
                            <Ellipse x:Name="NavFwDot" Width="7" Height="7"
                                     Fill="#10B981" VerticalAlignment="Center"
                                     ToolTipService.ToolTip="Firewall active"/>
                        </StackPanel>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavSecurity"
                                    Tag="Security"
                                    ToolTipService.ToolTip="Security Center — threat detection">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Security"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavProxy"
                                    Tag="Proxy"
                                    ToolTipService.ToolTip="Proxy Manager">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE703;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Proxy"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavVpn"
                                    Tag="Vpn"
                                    ToolTipService.ToolTip="VPN Manager — detect, kill-switch, leak test">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE701;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="VPN"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <!-- ── TOOLS ── -->
                <NavigationViewItemHeader Content="TOOLS"/>

                <NavigationViewItem x:Name="NavPacketCapture"
                                    Tag="PacketCapture"
                                    ToolTipService.ToolTip="Packet Capture — Wireshark-style">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72C;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Packet Capture"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavHttpInspector"
                                    Tag="HttpInspector"
                                    ToolTipService.ToolTip="HTTP/HTTPS Inspector">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8C4;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="HTTP Inspector"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavSocket"
                                    Tag="Socket"
                                    ToolTipService.ToolTip="Socket Manager — open ports &amp; sockets">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EF;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Socket Manager"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavPortScanner"
                                    Tag="PortScanner"
                                    ToolTipService.ToolTip="Port Scanner">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Port Scanner"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavLan"
                                    Tag="Lan"
                                    ToolTipService.ToolTip="LAN Scanner — find devices on network">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F5;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="LAN Scanner"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavSpeed"
                                    Tag="Speed"
                                    ToolTipService.ToolTip="Internet Speed Test &amp; Benchmark">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC4A;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Speed Test"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavDiagnostics"
                                    Tag="Diagnostics"
                                    ToolTipService.ToolTip="Diagnostics — Ping, Trace, Whois, Dig">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9CE;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Diagnostics"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <!-- ── OPTIMIZATION ── -->
                <NavigationViewItemHeader Content="OPTIMIZATION"/>

                <NavigationViewItem x:Name="NavOptimizer"
                                    Tag="Optimizer"
                                    ToolTipService.ToolTip="Network Optimizer — one-click profiles">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC4A;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Optimizer"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavQos"
                                    Tag="Qos"
                                    ToolTipService.ToolTip="QoS Manager — bandwidth &amp; priorities">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8CB;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="QoS Manager"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavRouting"
                                    Tag="Routing"
                                    ToolTipService.ToolTip="Routing Tools — route table, traceroute, ASN">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE909;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Routing"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <!-- ── SYSTEM ── -->
                <NavigationViewItemHeader Content="SYSTEM"/>

                <NavigationViewItem x:Name="NavLogs"
                                    Tag="Logs"
                                    ToolTipService.ToolTip="Logs — firewall, DNS, DHCP, events">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Logs"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavAutomation"
                                    Tag="Automation"
                                    ToolTipService.ToolTip="Automation — rules, scripts, profiles">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F3;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Automation"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavReset"
                                    Tag="Reset"
                                    ToolTipService.ToolTip="Network Reset — Winsock, TCP/IP, DNS">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE777;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Network Reset"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavTerminal"
                                    Tag="Terminal"
                                    ToolTipService.ToolTip="Terminal — CMD, PowerShell, WSL">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE756;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Terminal"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavReporting"
                                    Tag="Reporting"
                                    ToolTipService.ToolTip="Reporting — PDF/HTML reports">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C3;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Reports"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavJourney"
                                    Tag="Journey"
                                    ToolTipService.ToolTip="Visual Packet Journey — animated flow map">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81E;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Packet Journey"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

            </NavigationView.MenuItems>

            <!-- Footer items -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavSettings"
                                    Tag="Settings"
                                    ToolTipService.ToolTip="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Settings"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- ═══ Content Frame ═══ -->
            <Frame x:Name="ContentFrame" NavigationFailed="ContentFrame_NavigationFailed"/>

        </NavigationView>

        <!-- IMP#26: App-wide toast notification overlay -->
        <!-- Floats above NavView; auto-dismissed after a few seconds.
             Being the last child in RootGrid ensures it renders on top. -->
        <InfoBar x:Name="AppToast"
                 IsOpen="False"
                 IsClosable="True"
                 VerticalAlignment="Bottom"
                 HorizontalAlignment="Right"
                 Margin="0,0,20,20"
                 MinWidth="280"
                 MaxWidth="420"
                 CornerRadius="10"/>
    </Grid>
</Window>
